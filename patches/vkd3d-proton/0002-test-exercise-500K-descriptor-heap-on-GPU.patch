-    UINT increment_size;
+    UINT increment_size = 0;
     int status = 1;

     vkd3d_limited_write_checkpoint(checkpoint_path, "RUNNING", "startup");
@@ -284,26 +335,136 @@ int main(int argc, char **argv)

     if (descriptor_heap)
     {
+        heap_properties.Type = D3D12_HEAP_TYPE_DEFAULT;
+        buffer_desc = vkd3d_limited_buffer_desc(VKD3D_LIMITED_COPY_BUFFER_SIZE);
+        buffer_desc.Flags = D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS;
+        stage = "descriptor-output";
+        if (FAILED(hr = ID3D12Device_CreateCommittedResource(device, &heap_properties,
+                D3D12_HEAP_FLAG_NONE, &buffer_desc, D3D12_RESOURCE_STATE_UNORDERED_ACCESS,
+                NULL, &IID_ID3D12Resource, (void **)&descriptor_output)))
+        {
+            vkd3d_limited_report_failure("CreateCommittedResource(descriptor output)", hr);
+            goto done;
+        }
+
         increment_size = ID3D12Device_GetDescriptorHandleIncrementSize(device,
                 D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV);
-        descriptor = ID3D12DescriptorHeap_GetCPUDescriptorHandleForHeapStart(descriptor_heap);
-        descriptor.ptr += (SIZE_T)(descriptor_count - 1) * increment_size;
-        memset(&cbv_desc, 0, sizeof(cbv_desc));
-        cbv_desc.BufferLocation = ID3D12Resource_GetGPUVirtualAddress(upload);
-        cbv_desc.SizeInBytes = VKD3D_LIMITED_COPY_BUFFER_SIZE;
-        ID3D12Device_CreateConstantBufferView(device, &cbv_desc, descriptor);
+
+        cpu_descriptor = ID3D12DescriptorHeap_GetCPUDescriptorHandleForHeapStart(descriptor_heap);
+        cpu_descriptor.ptr += 2 * increment_size;
+        memset(&uav_desc, 0, sizeof(uav_desc));
+        uav_desc.Format = DXGI_FORMAT_R32_TYPELESS;
+        uav_desc.ViewDimension = D3D12_UAV_DIMENSION_BUFFER;
+        uav_desc.Buffer.NumElements = VKD3D_LIMITED_COPY_BUFFER_SIZE / sizeof(uint32_t);
+        uav_desc.Buffer.Flags = D3D12_BUFFER_UAV_FLAG_RAW;
+        ID3D12Device_CreateUnorderedAccessView(device, descriptor_output, NULL, &uav_desc, cpu_descriptor);
+
+        cpu_descriptor = ID3D12DescriptorHeap_GetCPUDescriptorHandleForHeapStart(descriptor_heap);
+        cpu_descriptor.ptr += (SIZE_T)(descriptor_count - 1) * increment_size;
+        memset(&srv_desc, 0, sizeof(srv_desc));
+        srv_desc.Format = DXGI_FORMAT_R32_TYPELESS;
+        srv_desc.ViewDimension = D3D12_SRV_DIMENSION_BUFFER;
+        srv_desc.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
+        srv_desc.Buffer.NumElements = VKD3D_LIMITED_COPY_BUFFER_SIZE / sizeof(uint32_t);
+        srv_desc.Buffer.Flags = D3D12_BUFFER_SRV_FLAG_RAW;
+        ID3D12Device_CreateShaderResourceView(device, resource, &srv_desc, cpu_descriptor);
+
+        memset(descriptor_ranges, 0, sizeof(descriptor_ranges));
+        descriptor_ranges[0].RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_SRV;
+        descriptor_ranges[0].NumDescriptors = 5;
+        descriptor_ranges[0].BaseShaderRegister = 0;
+        descriptor_ranges[0].OffsetInDescriptorsFromTableStart = D3D12_DESCRIPTOR_RANGE_OFFSET_APPEND;
+        descriptor_ranges[1].RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_UAV;
+        descriptor_ranges[1].NumDescriptors = 3;
+        descriptor_ranges[1].BaseShaderRegister = 0;
+        descriptor_ranges[1].OffsetInDescriptorsFromTableStart = D3D12_DESCRIPTOR_RANGE_OFFSET_APPEND;
+
+        memset(root_parameters, 0, sizeof(root_parameters));
+        root_parameters[0].ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
+        root_parameters[0].DescriptorTable.NumDescriptorRanges = 1;
+        root_parameters[0].DescriptorTable.pDescriptorRanges = &descriptor_ranges[0];
+        root_parameters[0].ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;
+        root_parameters[1].ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
+        root_parameters[1].DescriptorTable.NumDescriptorRanges = 1;
+        root_parameters[1].DescriptorTable.pDescriptorRanges = &descriptor_ranges[1];
+        root_parameters[1].ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;
+        root_parameters[2].ParameterType = D3D12_ROOT_PARAMETER_TYPE_32BIT_CONSTANTS;
+        root_parameters[2].Constants.ShaderRegister = 0;
+        root_parameters[2].Constants.Num32BitValues = 2;
+        root_parameters[2].ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;
+
+        memset(&root_signature_desc, 0, sizeof(root_signature_desc));
+        root_signature_desc.NumParameters = 3;
+        root_signature_desc.pParameters = root_parameters;
+        stage = "descriptor-root-signature";
+        if (FAILED(hr = D3D12SerializeRootSignature(&root_signature_desc,
+                D3D_ROOT_SIGNATURE_VERSION_1_0, &root_signature_blob, NULL)))
+        {
+            vkd3d_limited_report_failure("D3D12SerializeRootSignature", hr);
+            goto done;
+        }
+        if (FAILED(hr = ID3D12Device_CreateRootSignature(device, 0,
+                ID3D10Blob_GetBufferPointer(root_signature_blob),
+                ID3D10Blob_GetBufferSize(root_signature_blob),
+                &IID_ID3D12RootSignature, (void **)&root_signature)))
+        {
+            vkd3d_limited_report_failure("CreateRootSignature", hr);
+            goto done;
+        }
+        ID3D10Blob_Release(root_signature_blob);
+        root_signature_blob = NULL;
+
+        memset(&pipeline_desc, 0, sizeof(pipeline_desc));
+        pipeline_desc.pRootSignature = root_signature;
+        pipeline_desc.CS.pShaderBytecode = vkd3d_limited_descriptor_cs;
+        pipeline_desc.CS.BytecodeLength = sizeof(vkd3d_limited_descriptor_cs);
+        stage = "descriptor-pipeline";
+        if (FAILED(hr = ID3D12Device_CreateComputePipelineState(device, &pipeline_desc,
+                &IID_ID3D12PipelineState, (void **)&pipeline_state)))
+        {
+            vkd3d_limited_report_failure("CreateComputePipelineState", hr);
+            goto done;
+        }
     }

-    stage = "copy";
+    stage = descriptor_heap ? "descriptor-gpu" : "copy";
     ID3D12GraphicsCommandList_CopyBufferRegion(command_list, resource, 0, upload, 0, sizeof(expected));
     memset(&barrier, 0, sizeof(barrier));
     barrier.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
     barrier.Transition.pResource = resource;
     barrier.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
     barrier.Transition.StateBefore = D3D12_RESOURCE_STATE_COPY_DEST;
-    barrier.Transition.StateAfter = D3D12_RESOURCE_STATE_COPY_SOURCE;
+    barrier.Transition.StateAfter = descriptor_heap
+            ? D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE : D3D12_RESOURCE_STATE_COPY_SOURCE;
     ID3D12GraphicsCommandList_ResourceBarrier(command_list, 1, &barrier);
-    ID3D12GraphicsCommandList_CopyBufferRegion(command_list, readback, 0, resource, 0, sizeof(expected));
+
+    if (descriptor_heap)
+    {
+        ID3D12GraphicsCommandList_SetComputeRootSignature(command_list, root_signature);
+        ID3D12GraphicsCommandList_SetPipelineState(command_list, pipeline_state);
+        ID3D12GraphicsCommandList_SetDescriptorHeaps(command_list, 1, &descriptor_heap);
+
+        gpu_descriptor = ID3D12DescriptorHeap_GetGPUDescriptorHandleForHeapStart(descriptor_heap);
+        gpu_descriptor.ptr += (UINT64)(descriptor_count - 5) * increment_size;
+        ID3D12GraphicsCommandList_SetComputeRootDescriptorTable(command_list, 0, gpu_descriptor);
+        gpu_descriptor = ID3D12DescriptorHeap_GetGPUDescriptorHandleForHeapStart(descriptor_heap);
+        ID3D12GraphicsCommandList_SetComputeRootDescriptorTable(command_list, 1, gpu_descriptor);
+        ID3D12GraphicsCommandList_SetComputeRoot32BitConstant(command_list, 2, 0, 0);
+        ID3D12GraphicsCommandList_SetComputeRoot32BitConstant(command_list, 2,
+                sizeof(expected) / sizeof(uint32_t), 1);
+        ID3D12GraphicsCommandList_Dispatch(command_list, 1, 1, 1);
+
+        barrier.Transition.pResource = descriptor_output;
+        barrier.Transition.StateBefore = D3D12_RESOURCE_STATE_UNORDERED_ACCESS;
+        barrier.Transition.StateAfter = D3D12_RESOURCE_STATE_COPY_SOURCE;
+        ID3D12GraphicsCommandList_ResourceBarrier(command_list, 1, &barrier);
+        ID3D12GraphicsCommandList_CopyBufferRegion(command_list, readback, 0,
+                descriptor_output, 0, sizeof(expected));
+    }
+    else
+    {
+        ID3D12GraphicsCommandList_CopyBufferRegion(command_list, readback, 0, resource, 0, sizeof(expected));
+    }

     if (FAILED(hr = ID3D12GraphicsCommandList_Close(command_list)))
     {
@@ -389,8 +550,16 @@ done:
         CloseHandle(completion_event);
     if (fence)
         ID3D12Fence_Release(fence);
+    if (root_signature_blob)
+        ID3D10Blob_Release(root_signature_blob);
+    if (pipeline_state)
+        ID3D12PipelineState_Release(pipeline_state);
+    if (root_signature)
+        ID3D12RootSignature_Release(root_signature);
     if (readback)
         ID3D12Resource_Release(readback);
+    if (descriptor_output)
+        ID3D12Resource_Release(descriptor_output);
     if (resource)
         ID3D12Resource_Release(resource);
     if (upload)
@@ -411,7 +580,13 @@ done:
         FreeLibrary(d3d12_module);

     /* A passing readback is insufficient if object teardown faults. */
-    vkd3d_limited_write_result(result_path, status, stage);
+    if (!vkd3d_limited_write_result(result_path, status, stage))
+    {
+        fprintf(stderr, "VKD3D_LIMITED_500K_MICROTEST FAIL: could not persist final result.\n");
+        return 1;
+    }
+    fprintf(stderr, "VKD3D_LIMITED_500K_MICROTEST FINAL: status=%s stage=%s result_written=1.\n",
+            status ? "FAIL" : "PASS", stage);

     return status;
 }
