 tests/vkd3d_limited_500k_microtest.c | 215 ++++++++++++++++++++++++---
 1 file changed, 195 insertions(+), 20 deletions(-)

diff --git a/tests/vkd3d_limited_500k_microtest.c b/tests/vkd3d_limited_500k_microtest.c
index 1732c314..9385b296 100644
--- a/tests/vkd3d_limited_500k_microtest.c
+++ b/tests/vkd3d_limited_500k_microtest.c
@@ -17,6 +17,46 @@
 #define VKD3D_LIMITED_MAX_RESOURCE_VIEW_HEAP_SIZE 500000u
