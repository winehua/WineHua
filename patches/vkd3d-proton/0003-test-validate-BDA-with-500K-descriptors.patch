+    read_range.End = descriptor_heap
+            ? VKD3D_LIMITED_BDA_READBACK_OFFSET + sizeof(expected) : sizeof(expected);
     stage = "readback";
     if (FAILED(hr = ID3D12Resource_Map(readback, 0, &read_range, &mapped_data)))
     {
@@ -518,21 +637,16 @@ int main(int argc, char **argv)
         goto done;
