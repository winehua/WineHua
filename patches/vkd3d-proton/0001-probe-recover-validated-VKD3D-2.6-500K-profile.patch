diff --git a/tests/vkd3d_limited_500k_microtest.c b/tests/vkd3d_limited_500k_microtest.c
new file mode 100644
index 00000000..1732c314
--- /dev/null
+++ b/tests/vkd3d_limited_500k_microtest.c
@@ -0,0 +1,417 @@
+/*
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ *
+ * Default-off experimental validation for 500K resource-view descriptor heaps.
+ */
+
+#define COBJMACROS
+#include "vkd3d_win32.h"
+#include "vkd3d_d3d12.h"
+
+#include <errno.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define VKD3D_LIMITED_MAX_RESOURCE_VIEW_HEAP_SIZE 500000u
+#define VKD3D_LIMITED_COPY_BUFFER_SIZE 256u
+
+static D3D12_RESOURCE_DESC vkd3d_limited_buffer_desc(UINT64 size)
+{
+    D3D12_RESOURCE_DESC desc;
+
+    memset(&desc, 0, sizeof(desc));
+    desc.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER;
+    desc.Width = size;
+    desc.Height = 1;
+    desc.DepthOrArraySize = 1;
+    desc.MipLevels = 1;
+    desc.Format = DXGI_FORMAT_UNKNOWN;
+    desc.SampleDesc.Count = 1;
+    desc.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+    return desc;
+}
+
+static void vkd3d_limited_report_failure(const char *operation, HRESULT hr)
+{
+    fprintf(stderr, "VKD3D_LIMITED_500K_MICROTEST FAIL: %s returned %#lx.\n", operation, hr);
+}
+
+static const char *vkd3d_limited_find_argument(int argc, char **argv, const char *name)
+{
+    int i;
+
+    for (i = 1; i + 1 < argc; i++)
+    {
+        if (!strcmp(argv[i], name))
+            return argv[i + 1];
+    }
+
+    return NULL;
+}
+
+static int vkd3d_limited_parse_descriptor_count(int argc, char **argv, UINT *descriptor_count)
+{
+    const char *argument = vkd3d_limited_find_argument(argc, argv, "--descriptor-count");
+    char *end;
+    unsigned long value;
+
+    if (!argument)
+    {
+        *descriptor_count = VKD3D_LIMITED_MAX_RESOURCE_VIEW_HEAP_SIZE;
+        return 1;
+    }
+
+    errno = 0;
+    value = strtoul(argument, &end, 10);
+    if (errno || !end || *end || value > VKD3D_LIMITED_MAX_RESOURCE_VIEW_HEAP_SIZE)
+    {
+        fprintf(stderr, "VKD3D_LIMITED_500K_MICROTEST FAIL: --descriptor-count must be 0 through %u.\n",
+                VKD3D_LIMITED_MAX_RESOURCE_VIEW_HEAP_SIZE);
+        return 0;
+    }
+
+    *descriptor_count = (UINT)value;
+    return 1;
+}
+
+static void vkd3d_limited_dump_bytes(const char *label, const uint8_t *bytes, size_t byte_count)
+{
+    size_t i;
+
+    fprintf(stderr, "VKD3D_LIMITED_500K_MICROTEST %s:", label);
+    for (i = 0; i < byte_count; ++i)
+        fprintf(stderr, " %02x", bytes[i]);
+    fputc('\n', stderr);
+}
+
+static void vkd3d_limited_write_result(const char *path, int status, const char *stage)
+{
+    FILE *file;
+
+    if (!path || !(file = fopen(path, "wb")))
+        return;
+
+    fprintf(file, "{\"status\":\"%s\",\"stage\":\"%s\",\"message\":\"%s\"}\n",
+            status ? "FAIL" : "PASS", stage,
+            status ? "see Wine stderr for the failed 500K microtest operation"
+                    : "500K descriptor heap and D3D12 copy/readback passed");
+    fclose(file);
+}
+
+/*
+ * Keep this separate from the final result. The process may fault while Wine
+ * tears down Vulkan objects, so the checkpoint establishes how far the actual
+ * D3D12 work progressed without treating a faulty process exit as a pass.
+ */
+static void vkd3d_limited_write_checkpoint(const char *path, const char *state, const char *stage)
+{
+    FILE *file;
+
+    if (!path || !(file = fopen(path, "wb")))
+        return;
+
+    fprintf(file, "{\"state\":\"%s\",\"stage\":\"%s\"}\\n", state, stage);
+    fclose(file);
+}
+
+int main(int argc, char **argv)
+{
+    static const uint8_t expected[] = {
+        0x56, 0x4b, 0x44, 0x33, 0x44, 0x2d, 0x35, 0x30,
+        0x30, 0x4b, 0x2d, 0x43, 0x4f, 0x50, 0x59, 0x00,
+    };
+    D3D12_DESCRIPTOR_HEAP_DESC descriptor_heap_desc;
+    D3D12_COMMAND_QUEUE_DESC queue_desc;
+    D3D12_HEAP_PROPERTIES heap_properties;
+    D3D12_RESOURCE_BARRIER barrier;
+    D3D12_CONSTANT_BUFFER_VIEW_DESC cbv_desc;
+    D3D12_CPU_DESCRIPTOR_HANDLE descriptor;
+    D3D12_RANGE read_range;
+    D3D12_RANGE write_range;
+    D3D12_RESOURCE_DESC buffer_desc;
+    ID3D12GraphicsCommandList *command_list = NULL;
+    ID3D12CommandAllocator *command_allocator = NULL;
+    ID3D12CommandQueue *command_queue = NULL;
+    ID3D12DescriptorHeap *descriptor_heap = NULL;
+    ID3D12DescriptorHeap *oversized_descriptor_heap = NULL;
+    ID3D12Fence *fence = NULL;
+    ID3D12Device *device = NULL;
+    ID3D12Resource *upload = NULL;
+    ID3D12Resource *resource = NULL;
+    ID3D12Resource *readback = NULL;
+    ID3D12CommandList *command_lists[1];
+    PFN_D3D12_CREATE_DEVICE create_device;
+    const char *result_path = vkd3d_limited_find_argument(argc, argv, "--result");
+    const char *checkpoint_path = vkd3d_limited_find_argument(argc, argv, "--checkpoint");
+    const char *stage = "loader";
+    HMODULE d3d12_module = NULL;
+    HANDLE completion_event = NULL;
+    char module_path[MAX_PATH];
+    void *mapped_data = NULL;
+    HRESULT hr = E_FAIL;
+    UINT descriptor_count;
+    UINT increment_size;
+    int status = 1;
+
+    vkd3d_limited_write_checkpoint(checkpoint_path, "RUNNING", "startup");
+
+    if (!vkd3d_limited_parse_descriptor_count(argc, argv, &descriptor_count))
+        goto done;
+
+    fprintf(stderr, "VKD3D_LIMITED_500K_MICROTEST CONFIG: descriptor_count=%u.\n", descriptor_count);
+
+    if (!(d3d12_module = LoadLibraryA("d3d12.dll")))
+    {
+        fprintf(stderr, "VKD3D_LIMITED_500K_MICROTEST FAIL: could not load d3d12.dll.\n");
+        goto done;
+    }
+
+    if (GetModuleFileNameA(d3d12_module, module_path, sizeof(module_path)))
+        fprintf(stderr, "VKD3D_LIMITED_500K_MICROTEST DLL: %s\n", module_path);
+
+    if (!(create_device = (PFN_D3D12_CREATE_DEVICE)GetProcAddress(d3d12_module, "D3D12CreateDevice")))
+    {
+        fprintf(stderr, "VKD3D_LIMITED_500K_MICROTEST FAIL: D3D12CreateDevice export is missing.\n");
+        goto done;
+    }
+
+    stage = "device";
+    if (FAILED(hr = create_device(NULL, D3D_FEATURE_LEVEL_11_0, &IID_ID3D12Device, (void **)&device)))
+    {
+        vkd3d_limited_report_failure("D3D12CreateDevice", hr);
+        goto done;
+    }
+
+    if (descriptor_count)
+    {
+        memset(&descriptor_heap_desc, 0, sizeof(descriptor_heap_desc));
+        descriptor_heap_desc.Type = D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV;
+        descriptor_heap_desc.NumDescriptors = descriptor_count;
+        descriptor_heap_desc.Flags = D3D12_DESCRIPTOR_HEAP_FLAG_SHADER_VISIBLE;
+        stage = "descriptor-heap";
+        if (FAILED(hr = ID3D12Device_CreateDescriptorHeap(device, &descriptor_heap_desc,
+                &IID_ID3D12DescriptorHeap, (void **)&descriptor_heap)))
+        {
+            vkd3d_limited_report_failure("CreateDescriptorHeap", hr);
+            goto done;
+        }
+
+        if (descriptor_count == VKD3D_LIMITED_MAX_RESOURCE_VIEW_HEAP_SIZE)
+        {
+            descriptor_heap_desc.NumDescriptors = VKD3D_LIMITED_MAX_RESOURCE_VIEW_HEAP_SIZE + 1;
+            if ((hr = ID3D12Device_CreateDescriptorHeap(device, &descriptor_heap_desc,
+                    &IID_ID3D12DescriptorHeap, (void **)&oversized_descriptor_heap)) != E_INVALIDARG)
+            {
+                vkd3d_limited_report_failure("CreateDescriptorHeap(500001) expected E_INVALIDARG", hr);
+                goto done;
+            }
+            if (oversized_descriptor_heap)
+            {
+                fprintf(stderr, "VKD3D_LIMITED_500K_MICROTEST FAIL: CreateDescriptorHeap(500001) returned an object.\n");
+                goto done;
+            }
+        }
+    }
+
+    memset(&queue_desc, 0, sizeof(queue_desc));
+    queue_desc.Type = D3D12_COMMAND_LIST_TYPE_DIRECT;
+    if (FAILED(hr = ID3D12Device_CreateCommandQueue(device, &queue_desc,
+            &IID_ID3D12CommandQueue, (void **)&command_queue)))
+    {
+        vkd3d_limited_report_failure("CreateCommandQueue", hr);
+        goto done;
+    }
+
+    if (FAILED(hr = ID3D12Device_CreateCommandAllocator(device, D3D12_COMMAND_LIST_TYPE_DIRECT,
+            &IID_ID3D12CommandAllocator, (void **)&command_allocator)))
+    {
+        vkd3d_limited_report_failure("CreateCommandAllocator", hr);
+        goto done;
+    }
+
+    if (FAILED(hr = ID3D12Device_CreateCommandList(device, 0, D3D12_COMMAND_LIST_TYPE_DIRECT,
+            command_allocator, NULL, &IID_ID3D12GraphicsCommandList, (void **)&command_list)))
+    {
+        vkd3d_limited_report_failure("CreateCommandList", hr);
+        goto done;
+    }
+
+    memset(&heap_properties, 0, sizeof(heap_properties));
+    heap_properties.Type = D3D12_HEAP_TYPE_UPLOAD;
+    buffer_desc = vkd3d_limited_buffer_desc(VKD3D_LIMITED_COPY_BUFFER_SIZE);
+    if (FAILED(hr = ID3D12Device_CreateCommittedResource(device, &heap_properties,
+            D3D12_HEAP_FLAG_NONE, &buffer_desc,
+            D3D12_RESOURCE_STATE_GENERIC_READ, NULL, &IID_ID3D12Resource, (void **)&upload)))
+    {
+        vkd3d_limited_report_failure("CreateCommittedResource(upload)", hr);
+        goto done;
+    }
+
+    read_range.Begin = 0;
+    read_range.End = 0;
+    if (FAILED(hr = ID3D12Resource_Map(upload, 0, &read_range, &mapped_data)))
+    {
+        vkd3d_limited_report_failure("Map(upload)", hr);
+        goto done;
+    }
+    memcpy(mapped_data, expected, sizeof(expected));
+    write_range.Begin = 0;
+    write_range.End = sizeof(expected);
+    ID3D12Resource_Unmap(upload, 0, &write_range);
+    mapped_data = NULL;
+
+    heap_properties.Type = D3D12_HEAP_TYPE_DEFAULT;
+    buffer_desc = vkd3d_limited_buffer_desc(VKD3D_LIMITED_COPY_BUFFER_SIZE);
+    if (FAILED(hr = ID3D12Device_CreateCommittedResource(device, &heap_properties,
+            D3D12_HEAP_FLAG_NONE, &buffer_desc,
+            D3D12_RESOURCE_STATE_COPY_DEST, NULL, &IID_ID3D12Resource, (void **)&resource)))
+    {
+        vkd3d_limited_report_failure("CreateCommittedResource(default)", hr);
+        goto done;
+    }
+
+    heap_properties.Type = D3D12_HEAP_TYPE_READBACK;
+    buffer_desc = vkd3d_limited_buffer_desc(VKD3D_LIMITED_COPY_BUFFER_SIZE);
+    if (FAILED(hr = ID3D12Device_CreateCommittedResource(device, &heap_properties,
+            D3D12_HEAP_FLAG_NONE, &buffer_desc,
+            D3D12_RESOURCE_STATE_COPY_DEST, NULL, &IID_ID3D12Resource, (void **)&readback)))
+    {
+        vkd3d_limited_report_failure("CreateCommittedResource(readback)", hr);
+        goto done;
+    }
+
+    if (descriptor_heap)
+    {
+        increment_size = ID3D12Device_GetDescriptorHandleIncrementSize(device,
+                D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV);
+        descriptor = ID3D12DescriptorHeap_GetCPUDescriptorHandleForHeapStart(descriptor_heap);
+        descriptor.ptr += (SIZE_T)(descriptor_count - 1) * increment_size;
+        memset(&cbv_desc, 0, sizeof(cbv_desc));
+        cbv_desc.BufferLocation = ID3D12Resource_GetGPUVirtualAddress(upload);
+        cbv_desc.SizeInBytes = VKD3D_LIMITED_COPY_BUFFER_SIZE;
+        ID3D12Device_CreateConstantBufferView(device, &cbv_desc, descriptor);
+    }
+
+    stage = "copy";
+    ID3D12GraphicsCommandList_CopyBufferRegion(command_list, resource, 0, upload, 0, sizeof(expected));
+    memset(&barrier, 0, sizeof(barrier));
+    barrier.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    barrier.Transition.pResource = resource;
+    barrier.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    barrier.Transition.StateBefore = D3D12_RESOURCE_STATE_COPY_DEST;
+    barrier.Transition.StateAfter = D3D12_RESOURCE_STATE_COPY_SOURCE;
+    ID3D12GraphicsCommandList_ResourceBarrier(command_list, 1, &barrier);
+    ID3D12GraphicsCommandList_CopyBufferRegion(command_list, readback, 0, resource, 0, sizeof(expected));
+
+    if (FAILED(hr = ID3D12GraphicsCommandList_Close(command_list)))
+    {
+        vkd3d_limited_report_failure("Close(command list)", hr);
+        goto done;
+    }
+
+    command_lists[0] = (ID3D12CommandList *)command_list;
+    ID3D12CommandQueue_ExecuteCommandLists(command_queue, 1, command_lists);
+
+    if (FAILED(hr = ID3D12Device_CreateFence(device, 0, D3D12_FENCE_FLAG_NONE,
+            &IID_ID3D12Fence, (void **)&fence)))
+    {
+        vkd3d_limited_report_failure("CreateFence", hr);
+        goto done;
+    }
+
+    if (FAILED(hr = ID3D12CommandQueue_Signal(command_queue, fence, 1)))
+    {
+        vkd3d_limited_report_failure("Signal(fence)", hr);
+        goto done;
+    }
+
+    if (ID3D12Fence_GetCompletedValue(fence) < 1)
+    {
+        if (!(completion_event = CreateEventA(NULL, FALSE, FALSE, NULL)))
+        {
+            fprintf(stderr, "VKD3D_LIMITED_500K_MICROTEST FAIL: CreateEvent failed.\n");
+            goto done;
+        }
+
+        if (FAILED(hr = ID3D12Fence_SetEventOnCompletion(fence, 1, completion_event)))
+        {
+            vkd3d_limited_report_failure("SetEventOnCompletion", hr);
+            goto done;
+        }
+
+        if (WaitForSingleObject(completion_event, INFINITE) != WAIT_OBJECT_0)
+        {
+            fprintf(stderr, "VKD3D_LIMITED_500K_MICROTEST FAIL: fence wait failed.\n");
+            goto done;
+        }
+    }
+
+    read_range.Begin = 0;
+    read_range.End = sizeof(expected);
+    stage = "readback";
+    if (FAILED(hr = ID3D12Resource_Map(readback, 0, &read_range, &mapped_data)))
+    {
+        vkd3d_limited_report_failure("Map(readback)", hr);
+        goto done;
+    }
+
+    if (memcmp(mapped_data, expected, sizeof(expected)))
+    {
+        const uint8_t *actual = mapped_data;
+        size_t mismatch_index;
+
+        for (mismatch_index = 0; mismatch_index < sizeof(expected); ++mismatch_index)
+        {
+            if (actual[mismatch_index] != expected[mismatch_index])
+                break;
+        }
+        fprintf(stderr, "VKD3D_LIMITED_500K_MICROTEST FAIL: readback bytes differ at offset %zu, expected %02x, actual %02x.\n",
+                mismatch_index, expected[mismatch_index], actual[mismatch_index]);
+        vkd3d_limited_dump_bytes("EXPECTED", expected, sizeof(expected));
+        vkd3d_limited_dump_bytes("ACTUAL", actual, sizeof(expected));
+        goto done;
+    }
+    ID3D12Resource_Unmap(readback, 0, NULL);
+    mapped_data = NULL;
+
+    printf("VKD3D_LIMITED_500K_MICROTEST PASS\n");
+    stage = "complete";
+    status = 0;
+
+done:
+    vkd3d_limited_write_checkpoint(checkpoint_path,
+            status ? "FAIL" : "PASS_PENDING_TEARDOWN", stage);
+    if (mapped_data && readback)
+        ID3D12Resource_Unmap(readback, 0, NULL);
+    if (completion_event)
+        CloseHandle(completion_event);
+    if (fence)
+        ID3D12Fence_Release(fence);
+    if (readback)
+        ID3D12Resource_Release(readback);
+    if (resource)
+        ID3D12Resource_Release(resource);
+    if (upload)
+        ID3D12Resource_Release(upload);
+    if (command_list)
+        ID3D12GraphicsCommandList_Release(command_list);
+    if (command_allocator)
+        ID3D12CommandAllocator_Release(command_allocator);
+    if (command_queue)
+        ID3D12CommandQueue_Release(command_queue);
+    if (descriptor_heap)
+        ID3D12DescriptorHeap_Release(descriptor_heap);
+    if (oversized_descriptor_heap)
+        ID3D12DescriptorHeap_Release(oversized_descriptor_heap);
+    if (device)
+        ID3D12Device_Release(device);
+    if (d3d12_module)
+        FreeLibrary(d3d12_module);
+
+    /* A passing readback is insufficient if object teardown faults. */
+    vkd3d_limited_write_result(result_path, status, stage);
+
+    return status;
+}
