diff --git a/libs/vkd3d/resource.c b/libs/vkd3d/resource.c
index 72fbb39c..be3d475f 100644
--- a/libs/vkd3d/resource.c
+++ b/libs/vkd3d/resource.c
@@ -1511,15 +1511,31 @@ static HRESULT STDMETHODCALLTYPE d3d12_resource_GetDevice(d3d12_resource_iface *
     return d3d12_device_query_interface(resource->device, iid, device);
 }

+static bool vkd3d_winehua_force_coherent_map_sync(void)
+{
+    const char *value = getenv("VKD3D_WINEHUA_FORCE_COHERENT_MAP_SYNC");
+
+    return value && value[0] == '1' && !value[1];
+}
+
 static bool d3d12_resource_get_mapped_memory_range(struct d3d12_resource *resource,
         UINT subresource, const D3D12_RANGE *range, VkMappedMemoryRange *vk_mapped_range)
 {
     const struct d3d12_device *device = resource->device;
+    VkDeviceSize atom_size;
+    VkDeviceSize range_end;

     if (range && range->End <= range->Begin)
         return false;

-    if (device->memory_properties.memoryTypes[resource->mem.device_allocation.vk_memory_type].propertyFlags & VK_MEMORY_PROPERTY_HOST_COHERENT_BIT)
+    /* WineHua's OHOS vtest transport uses distinct Host and Guest mappings.
+     * A Host-coherent allocation therefore still needs an explicit command to
+     * propagate data through the shadow bridge. This is opt-in for the
+     * isolated capability probe; normal Vulkan coherent-memory semantics keep
+     * the fast path below. */
+    if ((device->memory_properties.memoryTypes[resource->mem.device_allocation.vk_memory_type].propertyFlags
+            & VK_MEMORY_PROPERTY_HOST_COHERENT_BIT) &&
+            !vkd3d_winehua_force_coherent_map_sync())
         return false;

     vk_mapped_range->sType = VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE;
@@ -1543,6 +1559,14 @@ static bool d3d12_resource_get_mapped_memory_range(struct d3d12_resource *resour
         vk_mapped_range->size = range->End - range->Begin;
     }

+    /* D3D12 map ranges are byte-granular, while non-coherent Vulkan cache
+     * operations must cover whole nonCoherentAtomSize units. */
+    atom_size = device->device_info.properties2.properties.limits.nonCoherentAtomSize;
+    range_end = vk_mapped_range->offset + vk_mapped_range->size;
+    vk_mapped_range->offset &= ~(atom_size - 1);
+    range_end = min(align(range_end, atom_size), resource->mem.device_allocation.size);
+    vk_mapped_range->size = range_end - vk_mapped_range->offset;
+
     return true;
 }

@@ -1627,6 +1651,18 @@ static HRESULT STDMETHODCALLTYPE d3d12_resource_Map(d3d12_resource_iface *iface,
         TRACE("Returning pointer %p.\n", *data);
     }

+    /* Mark upload allocations as CPU-written even when an application keeps
+     * the D3D12 resource persistently mapped and never calls Unmap. Venus uses
+     * this explicit flush as write intent and publishes the current contents
+     * immediately before queue submission. Readback heaps are deliberately
+     * excluded so stale Guest shadow data cannot overwrite Host GPU writes. */
+    if (vkd3d_winehua_force_coherent_map_sync()
+            && resource->heap_properties.Type == D3D12_HEAP_TYPE_UPLOAD)
+    {
+        const D3D12_RANGE write_intent_range = {0, 1};
+        d3d12_resource_flush_range(resource, sub_resource, &write_intent_range);
+    }
+
     d3d12_resource_invalidate_range(resource, sub_resource, read_range);
     return S_OK;
 }
@@ -5857,6 +5893,17 @@ HRESULT d3d12_descriptor_heap_create(struct d3d12_device *device,
         return E_INVALIDARG;
     }

+#ifdef VKD3D_EXPERIMENTAL_LIMITED_RESOURCE_VIEW_HEAPS
+    if ((desc->Flags & D3D12_DESCRIPTOR_HEAP_FLAG_SHADER_VISIBLE)
+            && desc->Type == D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV
+            && desc->NumDescriptors > VKD3D_MAX_SHADER_VISIBLE_RESOURCE_VIEW_DESCRIPTOR_COUNT)
+    {
+        WARN("Experimental 500K profile rejects shader-visible CBV/SRV/UAV heaps larger than %u descriptors.\n",
+                VKD3D_MAX_SHADER_VISIBLE_RESOURCE_VIEW_DESCRIPTOR_COUNT);
+        return E_INVALIDARG;
+    }
+#endif
+
     max_descriptor_count = (UINT32_MAX - sizeof(*object)) / descriptor_size;
     if (desc->NumDescriptors > max_descriptor_count)
     {
