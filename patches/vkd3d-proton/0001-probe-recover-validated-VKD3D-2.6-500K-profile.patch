         flags |= VKD3D_BINDLESS_UAV;

-    if (device_info->descriptor_indexing_properties.maxPerStageDescriptorUpdateAfterBindUniformBuffers >= 1000000 &&
+    if (device_info->descriptor_indexing_properties.maxPerStageDescriptorUpdateAfterBindUniformBuffers >=
+            VKD3D_MAX_SHADER_VISIBLE_RESOURCE_VIEW_DESCRIPTOR_COUNT &&
+            device_info->descriptor_indexing_properties.maxDescriptorSetUpdateAfterBindUniformBuffers >=
