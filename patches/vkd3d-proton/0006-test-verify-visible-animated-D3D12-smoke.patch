+    memset(&gpu_va, 0, sizeof(gpu_va));
+    if (FAILED(hr = ID3D12Device_CheckFeatureSupport(smoke->device,
+            D3D12_FEATURE_GPU_VIRTUAL_ADDRESS_SUPPORT, &gpu_va, sizeof(gpu_va))))
+        return graphics_smoke_fail(smoke, "feature_gpu_va", hr);
+    smoke->gpu_va_bits_per_resource = gpu_va.MaxGPUVirtualAddressBitsPerResource;
+    smoke->gpu_va_bits_per_process = gpu_va.MaxGPUVirtualAddressBitsPerProcess;
+
+    graphics_smoke_set_stage(smoke, "feature_options1");
+    memset(&options1, 0, sizeof(options1));
+    if (FAILED(hr = ID3D12Device_CheckFeatureSupport(smoke->device,
+            D3D12_FEATURE_D3D12_OPTIONS1, &options1, sizeof(options1))))
+        return graphics_smoke_fail(smoke, "feature_options1", hr);
+    smoke->wave_ops = options1.WaveOps;
+    smoke->int64_shader_ops = options1.Int64ShaderOps;
+    smoke->wave_lane_count_min = options1.WaveLaneCountMin;
+    smoke->wave_lane_count_max = options1.WaveLaneCountMax;
+    smoke->feature_query_verified = true;
+
+    memset(&options5, 0, sizeof(options5));
+    options5_ok = SUCCEEDED(ID3D12Device_CheckFeatureSupport(smoke->device,
+            D3D12_FEATURE_D3D12_OPTIONS5, &options5, sizeof(options5)));
+    memset(&options6, 0, sizeof(options6));
+    options6_ok = SUCCEEDED(ID3D12Device_CheckFeatureSupport(smoke->device,
+            D3D12_FEATURE_D3D12_OPTIONS6, &options6, sizeof(options6)));
+    memset(&options7, 0, sizeof(options7));
+    options7_ok = SUCCEEDED(ID3D12Device_CheckFeatureSupport(smoke->device,
+            D3D12_FEATURE_D3D12_OPTIONS7, &options7, sizeof(options7)));
+    smoke->render_pass_tier = options5.RenderPassesTier;
+    smoke->raytracing_tier = options5.RaytracingTier;
+    smoke->variable_shading_rate_tier = options6.VariableShadingRateTier;
+    smoke->mesh_shader_tier = options7.MeshShaderTier;
+    smoke->sampler_feedback_tier = options7.SamplerFeedbackTier;
+    smoke->advanced_feature_query_verified = options5_ok && options6_ok && options7_ok;
+
+    fprintf(stderr,
+            "VKD3D_GRAPHICS_SMOKE FEATURES: feature_level=%#x shader_model=%#x "
+            "root_signature=%u binding_tier=%u heap_tier=%u wave_ops=%u int64=%u "
+            "gpu_va=%u/%u advanced_queries=%u.\n",
+            smoke->max_feature_level, smoke->shader_model, smoke->root_signature_version,
+            smoke->resource_binding_tier, smoke->resource_heap_tier,
+            smoke->wave_ops ? 1 : 0, smoke->int64_shader_ops ? 1 : 0,
+            smoke->gpu_va_bits_per_resource, smoke->gpu_va_bits_per_process,
+            smoke->advanced_feature_query_verified ? 1 : 0);
