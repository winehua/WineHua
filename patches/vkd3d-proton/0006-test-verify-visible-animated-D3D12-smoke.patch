+    smoke->typed_uav_load_additional_formats = options.TypedUAVLoadAdditionalFormats;
+    smoke->rovs_supported = options.ROVsSupported;
+
+    graphics_smoke_set_stage(smoke, "feature_root_signature");
+    memset(&root_signature, 0, sizeof(root_signature));
+    root_signature.HighestVersion = D3D_ROOT_SIGNATURE_VERSION_1_1;
+    hr = ID3D12Device_CheckFeatureSupport(smoke->device,
+            D3D12_FEATURE_ROOT_SIGNATURE, &root_signature, sizeof(root_signature));
+    if (FAILED(hr))
+    {
+        root_signature.HighestVersion = D3D_ROOT_SIGNATURE_VERSION_1_0;
+        hr = ID3D12Device_CheckFeatureSupport(smoke->device,
+                D3D12_FEATURE_ROOT_SIGNATURE, &root_signature, sizeof(root_signature));
+    }
+    if (FAILED(hr))
+        return graphics_smoke_fail(smoke, "feature_root_signature", hr);
+    smoke->root_signature_version = root_signature.HighestVersion;
+
+    graphics_smoke_set_stage(smoke, "feature_shader_model");
