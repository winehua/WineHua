+static bool graphics_smoke_verify_buffer_transfer(struct graphics_smoke *smoke)
+{
+    enum { buffer_size = 4096 };
+    ID3D12Resource *upload = NULL;
+    ID3D12Resource *default_buffer = NULL;
+    ID3D12Resource *readback = NULL;
+    D3D12_HEAP_PROPERTIES heap_properties;
+    D3D12_RESOURCE_DESC resource_desc;
+    D3D12_RESOURCE_BARRIER barrier;
+    D3D12_RANGE empty_range = {0, 0};
+    D3D12_RANGE upload_written_range = {0, buffer_size};
+    D3D12_RANGE read_range = {0, buffer_size};
+    uint8_t *mapped;
+    bool passed = false;
+    unsigned int i;
+    HRESULT hr;
+
+    memset(&resource_desc, 0, sizeof(resource_desc));
+    resource_desc.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER;
+    resource_desc.Width = buffer_size;
+    resource_desc.Height = 1;
+    resource_desc.DepthOrArraySize = 1;
+    resource_desc.MipLevels = 1;
+    resource_desc.Format = DXGI_FORMAT_UNKNOWN;
+    resource_desc.SampleDesc.Count = 1;
+    resource_desc.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+
+    graphics_smoke_set_stage(smoke, "buffer_upload_create");
+    memset(&heap_properties, 0, sizeof(heap_properties));
+    heap_properties.Type = D3D12_HEAP_TYPE_UPLOAD;
+    heap_properties.CreationNodeMask = 1;
+    heap_properties.VisibleNodeMask = 1;
+    if (FAILED(hr = ID3D12Device_CreateCommittedResource(smoke->device,
+            &heap_properties, D3D12_HEAP_FLAG_NONE, &resource_desc,
+            D3D12_RESOURCE_STATE_GENERIC_READ, NULL, &IID_ID3D12Resource,
+            (void **)&upload)))
+    {
+        graphics_smoke_fail(smoke, "buffer_upload_create", hr);
+        goto done;
+    }
+
+    graphics_smoke_set_stage(smoke, "buffer_default_create");
+    heap_properties.Type = D3D12_HEAP_TYPE_DEFAULT;
+    if (FAILED(hr = ID3D12Device_CreateCommittedResource(smoke->device,
+            &heap_properties, D3D12_HEAP_FLAG_NONE, &resource_desc,
+            D3D12_RESOURCE_STATE_COPY_DEST, NULL, &IID_ID3D12Resource,
+            (void **)&default_buffer)))
+    {
+        graphics_smoke_fail(smoke, "buffer_default_create", hr);
+        goto done;
+    }
+
+    graphics_smoke_set_stage(smoke, "buffer_readback_create");
+    heap_properties.Type = D3D12_HEAP_TYPE_READBACK;
+    if (FAILED(hr = ID3D12Device_CreateCommittedResource(smoke->device,
+            &heap_properties, D3D12_HEAP_FLAG_NONE, &resource_desc,
+            D3D12_RESOURCE_STATE_COPY_DEST, NULL, &IID_ID3D12Resource,
+            (void **)&readback)))
+    {
+        graphics_smoke_fail(smoke, "buffer_readback_create", hr);
+        goto done;
+    }
+
+    graphics_smoke_set_stage(smoke, "buffer_upload_map");
+    if (FAILED(hr = ID3D12Resource_Map(upload, 0, &empty_range, (void **)&mapped)))
+    {
+        graphics_smoke_fail(smoke, "buffer_upload_map", hr);
+        goto done;
+    }
+    for (i = 0; i < buffer_size; ++i)
+        mapped[i] = (uint8_t)((i * 37u + 11u) & 0xffu);
+    ID3D12Resource_Unmap(upload, 0, &upload_written_range);
+
+    graphics_smoke_set_stage(smoke, "buffer_copy_record");
+    if (FAILED(hr = ID3D12CommandAllocator_Reset(smoke->command_allocator)))
+    {
+        graphics_smoke_fail(smoke, "buffer_copy_allocator_reset", hr);
+        goto done;
+    }
+    if (FAILED(hr = ID3D12GraphicsCommandList_Reset(smoke->command_list,
+            smoke->command_allocator, NULL)))
+    {
+        graphics_smoke_fail(smoke, "buffer_copy_list_reset", hr);
+        goto done;
+    }
+    ID3D12GraphicsCommandList_CopyBufferRegion(smoke->command_list,
+            default_buffer, 0, upload, 0, buffer_size);
+    memset(&barrier, 0, sizeof(barrier));
+    barrier.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    barrier.Transition.pResource = default_buffer;
+    barrier.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    barrier.Transition.StateBefore = D3D12_RESOURCE_STATE_COPY_DEST;
+    barrier.Transition.StateAfter = D3D12_RESOURCE_STATE_COPY_SOURCE;
+    ID3D12GraphicsCommandList_ResourceBarrier(smoke->command_list, 1, &barrier);
+    ID3D12GraphicsCommandList_CopyBufferRegion(smoke->command_list,
+            readback, 0, default_buffer, 0, buffer_size);
+    if (FAILED(hr = ID3D12GraphicsCommandList_Close(smoke->command_list)))
+    {
+        graphics_smoke_fail(smoke, "buffer_copy_list_close", hr);
+        goto done;
+    }
+    ID3D12CommandQueue_ExecuteCommandLists(smoke->command_queue, 1,
+            (ID3D12CommandList **)&smoke->command_list);
+    if (!graphics_smoke_wait_frame(smoke))
+        goto done;
+
+    graphics_smoke_set_stage(smoke, "buffer_readback_compare");
+    if (FAILED(hr = ID3D12Resource_Map(readback, 0, &read_range, (void **)&mapped)))
+    {
+        graphics_smoke_fail(smoke, "buffer_readback_map", hr);
+        goto done;
+    }
+    for (i = 0; i < buffer_size; ++i)
+    {
+        uint8_t expected = (uint8_t)((i * 37u + 11u) & 0xffu);
+        if (mapped[i] != expected)
+        {
+            fprintf(stderr,
+                    "VKD3D_GRAPHICS_SMOKE BUFFER_MISMATCH: offset=%u expected=%u actual=%u.\n",
+                    i, expected, mapped[i]);
+            ID3D12Resource_Unmap(readback, 0, &empty_range);
+            graphics_smoke_fail(smoke, "buffer_readback_mismatch", E_FAIL);
+            goto done;
+        }
+    }
+    ID3D12Resource_Unmap(readback, 0, &empty_range);
+    smoke->buffer_copy_verified = true;
+    fprintf(stderr,
+            "VKD3D_GRAPHICS_SMOKE BUFFER_COPY: verified_bytes=%u upload_default_readback=PASS.\n",
+            buffer_size);
+    passed = true;
+
+done:
+    if (readback)
+        ID3D12Resource_Release(readback);
+    if (default_buffer)
+        ID3D12Resource_Release(default_buffer);
+    if (upload)
+        ID3D12Resource_Release(upload);
+    return passed;
+}
