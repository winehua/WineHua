+static bool graphics_smoke_query_features(struct graphics_smoke *smoke)
+{
+    static const D3D_FEATURE_LEVEL requested_feature_levels[] =
+    {
+        D3D_FEATURE_LEVEL_12_1,
+        D3D_FEATURE_LEVEL_12_0,
+        D3D_FEATURE_LEVEL_11_1,
+        D3D_FEATURE_LEVEL_11_0,
+    };
+    static const D3D_SHADER_MODEL requested_shader_models[] =
+    {
+        D3D_SHADER_MODEL_6_6,
+        D3D_SHADER_MODEL_6_5,
+        D3D_SHADER_MODEL_6_4,
+        D3D_SHADER_MODEL_6_3,
+        D3D_SHADER_MODEL_6_2,
+        D3D_SHADER_MODEL_6_1,
+        D3D_SHADER_MODEL_6_0,
+        D3D_SHADER_MODEL_5_1,
+    };
+    D3D12_FEATURE_DATA_FEATURE_LEVELS feature_levels;
+    D3D12_FEATURE_DATA_D3D12_OPTIONS options;
+    D3D12_FEATURE_DATA_D3D12_OPTIONS1 options1;
+    D3D12_FEATURE_DATA_D3D12_OPTIONS5 options5;
+    D3D12_FEATURE_DATA_D3D12_OPTIONS6 options6;
+    D3D12_FEATURE_DATA_D3D12_OPTIONS7 options7;
+    D3D12_FEATURE_DATA_ROOT_SIGNATURE root_signature;
+    D3D12_FEATURE_DATA_SHADER_MODEL shader_model;
+    D3D12_FEATURE_DATA_GPU_VIRTUAL_ADDRESS_SUPPORT gpu_va;
+    bool options5_ok, options6_ok, options7_ok;
+    HRESULT hr = E_FAIL;
+    unsigned int i;
+
+    graphics_smoke_set_stage(smoke, "feature_levels");
+    memset(&feature_levels, 0, sizeof(feature_levels));
+    feature_levels.NumFeatureLevels = ARRAY_SIZE(requested_feature_levels);
+    feature_levels.pFeatureLevelsRequested = requested_feature_levels;
+    if (FAILED(hr = ID3D12Device_CheckFeatureSupport(smoke->device,
+            D3D12_FEATURE_FEATURE_LEVELS, &feature_levels, sizeof(feature_levels))))
+        return graphics_smoke_fail(smoke, "feature_levels", hr);
+    smoke->max_feature_level = feature_levels.MaxSupportedFeatureLevel;
+
+    graphics_smoke_set_stage(smoke, "feature_options");
+    memset(&options, 0, sizeof(options));
+    if (FAILED(hr = ID3D12Device_CheckFeatureSupport(smoke->device,
+            D3D12_FEATURE_D3D12_OPTIONS, &options, sizeof(options))))
+        return graphics_smoke_fail(smoke, "feature_options", hr);
+    smoke->resource_binding_tier = options.ResourceBindingTier;
