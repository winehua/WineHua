+static void graphics_smoke_set_vertex(struct graphics_smoke_vertex *vertex,
+        float x, float y, const struct demo_vec4 *colour)
+{
+    demo_vec3_set(&vertex->position, x, y, 0.0f);
+    vertex->colour = *colour;
+}
+
+static void graphics_smoke_write_block(struct graphics_smoke *smoke,
+        unsigned int first_vertex, float center_x, float center_y,
+        float half_width, float half_height, float rotation_cos, float rotation_sin,
+        const struct demo_vec4 colours[4])
+{
+    static const unsigned int indices[VKD3D_GRAPHICS_SMOKE_VERTICES_PER_BLOCK] =
+    {
+        0, 1, 2, 0, 2, 3,
+    };
+    const float local_x[4] = {-half_width, -half_width, half_width, half_width};
+    const float local_y[4] = {-half_height, half_height, half_height, -half_height};
+    const float aspect_scale = (float)smoke->height / (float)smoke->width;
+    float transformed_x[4];
+    float transformed_y[4];
+    unsigned int i;
+
+    for (i = 0; i < 4; ++i)
+    {
+        const float rotated_x = local_x[i] * rotation_cos - local_y[i] * rotation_sin;
+        const float rotated_y = local_x[i] * rotation_sin + local_y[i] * rotation_cos;
+        transformed_x[i] = center_x + rotated_x * aspect_scale;
+        transformed_y[i] = center_y + rotated_y;
+    }
+
+    for (i = 0; i < ARRAY_SIZE(indices); ++i)
+    {
+        const unsigned int corner = indices[i];
+        graphics_smoke_set_vertex(&smoke->mapped_vertices[first_vertex + i],
+                transformed_x[corner], transformed_y[corner], &colours[corner]);
+    }
+}
+
+static bool graphics_smoke_update_vertices(struct graphics_smoke *smoke)
+{
+    static const struct demo_vec4 block_colours[VKD3D_GRAPHICS_SMOKE_BLOCK_COUNT][4] =
+    {
+        {
+            {1.00f, 0.10f, 0.10f, 1.0f}, {1.00f, 0.90f, 0.05f, 1.0f},
+            {0.05f, 0.90f, 1.00f, 1.0f}, {0.95f, 0.10f, 1.00f, 1.0f},
+        },
+        {
+            {0.10f, 1.00f, 0.15f, 1.0f}, {0.10f, 0.45f, 1.00f, 1.0f},
+            {1.00f, 1.00f, 1.00f, 1.0f}, {0.45f, 1.00f, 0.10f, 1.0f},
+        },
+        {
+            {1.00f, 0.35f, 0.05f, 1.0f}, {0.65f, 0.10f, 1.00f, 1.0f},
+            {1.00f, 0.95f, 0.20f, 1.0f}, {0.15f, 0.80f, 1.00f, 1.0f},
+        },
+    };
+    D3D12_RANGE read_range = {0, 0};
+    D3D12_RANGE written_range =
+    {
+        0, sizeof(*smoke->mapped_vertices) * VKD3D_GRAPHICS_SMOKE_VERTEX_COUNT,
+    };
+    HRESULT hr;
+    const float c = smoke->rotation_cos;
+    const float s = smoke->rotation_sin;
+    const float c2 = c * c - s * s;
+    const float s2 = 2.0f * c * s;
+    const float c3 = c2 * c - s2 * s;
+    const float s3 = s2 * c + c2 * s;
+
+    if (FAILED(hr = ID3D12Resource_Map(smoke->vertex_buffer, 0, &read_range,
+            (void **)&smoke->mapped_vertices)))
+        return graphics_smoke_fail(smoke, "vertex_map", hr);
+
+    graphics_smoke_write_block(smoke, 0, 0.0f, 0.0f, 0.50f, 0.28f,
+            c, s, block_colours[0]);
+    graphics_smoke_write_block(smoke, VKD3D_GRAPHICS_SMOKE_VERTICES_PER_BLOCK,
+            -0.58f, 0.48f, 0.21f, 0.21f, c2, -s2, block_colours[1]);
+    graphics_smoke_write_block(smoke, 2 * VKD3D_GRAPHICS_SMOKE_VERTICES_PER_BLOCK,
+            0.58f, -0.48f, 0.21f, 0.21f, c3, s3, block_colours[2]);
+
+    /* WineHua's Venus transport mirrors host-visible memory explicitly. Give
+     * Unmap the precise write range so this valid D3D12 upload reaches the GPU
+     * before the following draw instead of remaining only in the guest map. */
+    ID3D12Resource_Unmap(smoke->vertex_buffer, 0, &written_range);
+    smoke->mapped_vertices = NULL;
+    return true;
+}
+
+static void graphics_smoke_advance_rotation(struct graphics_smoke *smoke)
+{
+    /* 0.04 radians per submitted frame: clearly visible at 60+ FPS without
+     * depending on CRT trigonometry or a frame-time sleep. */
+    static const float step_cos = 0.9992001067f;
+    static const float step_sin = 0.0399893342f;
+    const float next_cos = smoke->rotation_cos * step_cos - smoke->rotation_sin * step_sin;
+    const float next_sin = smoke->rotation_sin * step_cos + smoke->rotation_cos * step_sin;
+
+    smoke->rotation_cos = next_cos;
+    smoke->rotation_sin = next_sin;
+}
