+/* Enabled by the qualified Zink product route; retain a runtime opt-out.
+ * Only driver-private, non-persistent uploader buffers enter this queue. */
+bool
+zink_winehua_queue_mapped_flush(struct zink_context *ctx,
+                               struct zink_resource_object *obj,
+                               const VkMappedMemoryRange *range)
+{
+   if (!ctx || !ctx->bs || ctx->bs->is_device_lost || !range->size || range->size == VK_WHOLE_SIZE ||
+       !debug_get_bool_option("WINEHUA_ZINK_BATCH_UPLOAD", false))
+      return false;
+
+   struct zink_screen *screen = zink_screen(ctx->base.screen);
+   struct zink_batch_state *bs = ctx->bs;
+   unsigned count = util_dynarray_num_elements(&bs->winehua_mapped_flushes,
+                                               struct zink_winehua_mapped_flush);
+   if (count) {
+      struct zink_winehua_mapped_flush *last = util_dynarray_top_ptr(
+         &bs->winehua_mapped_flushes, struct zink_winehua_mapped_flush);
+      /* Do not include unwritten gaps or a replacement backing object. */
+      if (last->obj == obj && range->offset >= last->range.offset &&
+          range->offset <= last->range.offset + last->range.size) {
+         VkDeviceSize end = MAX2(last->range.offset + last->range.size,
+                                range->offset + range->size);
+         last->range.size = end - last->range.offset;
+         return true;
+      }
+   }
+   /* Bound pending metadata. Publish on the recording thread, never after
+    * the next batch may have reused or renamed an upload buffer. */
+   if (count >= 4096 && zink_winehua_flush_mapped_uploads(screen, bs) != VK_SUCCESS)
+      return false;
+   if (!zink_bo_map(screen, obj->bo))
+      return false;
+   struct zink_winehua_mapped_flush *pending = util_dynarray_grow(
+      &bs->winehua_mapped_flushes, struct zink_winehua_mapped_flush, 1);
+   if (!pending) {
+      zink_bo_unmap(screen, obj->bo);
+      return false;
+   }
+   pending->obj = NULL;
+   zink_resource_object_reference(screen, &pending->obj, obj);
+   pending->range = *range;
+   return true;
+}
+
+static int
+winehua_compare_mapped_flush(const void *a, const void *b)
+{
+   const struct zink_winehua_mapped_flush *x = a, *y = b;
+   uint64_t xm = (uint64_t)(uintptr_t)x->range.memory;
+   uint64_t ym = (uint64_t)(uintptr_t)y->range.memory;
+   if (xm != ym)
+      return xm < ym ? -1 : 1;
+   if (x->range.offset != y->range.offset)
+      return x->range.offset < y->range.offset ? -1 : 1;
+   return 0;
+}
+
+VkResult
+zink_winehua_flush_mapped_uploads(struct zink_screen *screen,
+                                 struct zink_batch_state *bs)
+{
+   unsigned count = util_dynarray_num_elements(&bs->winehua_mapped_flushes,
+                                               struct zink_winehua_mapped_flush);
+   if (!count)
+      return bs->is_device_lost ? VK_ERROR_DEVICE_LOST : VK_SUCCESS;
+   struct zink_winehua_mapped_flush *pending = bs->winehua_mapped_flushes.data;
+   qsort(pending, count, sizeof(*pending), winehua_compare_mapped_flush);
+   VkMappedMemoryRange ranges[256];
+   unsigned n = 0;
+   VkResult result = bs->is_device_lost ? VK_ERROR_DEVICE_LOST : VK_SUCCESS;
+   for (unsigned i = 0; i < count && result == VK_SUCCESS; i++) {
+      const VkMappedMemoryRange *range = &pending[i].range;
+      if (n && ranges[n-1].memory == range->memory &&
+          range->offset <= ranges[n-1].offset + ranges[n-1].size) {
+         VkDeviceSize end = MAX2(ranges[n-1].offset + ranges[n-1].size,
+                                range->offset + range->size);
+         ranges[n-1].size = end - ranges[n-1].offset;
+         continue;
+      }
+      if (n == ARRAY_SIZE(ranges)) {
+         result = VKSCR(FlushMappedMemoryRanges)(screen->dev, n, ranges);
+         n = 0;
+         if (result != VK_SUCCESS)
+            break;
+      }
+      ranges[n++] = *range;
+   }
+   if (result == VK_SUCCESS && n) {
+      result = VKSCR(FlushMappedMemoryRanges)(screen->dev, n, ranges);
+   }
+   for (unsigned i = 0; i < count; i++) {
+      zink_bo_unmap(screen, pending[i].obj->bo);
+      zink_resource_object_reference(screen, &pending[i].obj, NULL);
+   }
+   util_dynarray_clear(&bs->winehua_mapped_flushes);
+   if (result != VK_SUCCESS) {
+      bs->is_device_lost = true;
+      mesa_loge("ZINK: batched shadow upload failed (%s)", vk_Result_to_str(result));
+   }
+   return result;
 }
 
