+++ b/src/gallium/winsys/virgl/vtest/virgl_vtest_write_pair.h
@@ -0,0 +1,52 @@
+/* SPDX-License-Identifier: MIT
+ * Send one vtest command without changing the byte stream or reply boundaries.
+ */
+#ifndef VIRGL_VTEST_WRITE_PAIR_H
+#define VIRGL_VTEST_WRITE_PAIR_H
+#include <errno.h>
+#include <limits.h>
+#include <stdint.h>
+#include <sys/uio.h>
+
+static inline int
+virgl_vtest_write_pair(int fd, const void *header, size_t header_size,
+                       const void *body, size_t body_size)
+{
+   struct iovec parts[2] = {
+      { .iov_base = (void *)header, .iov_len = header_size },
+      { .iov_base = (void *)body, .iov_len = body_size },
+   };
+   struct iovec *next = parts;
+   int count = 2;
+
+   if (header_size > SSIZE_MAX || body_size > SSIZE_MAX - header_size)
+      return -EOVERFLOW;
+   while (count) {
+      while (count && !next->iov_len) {
+         next++;
+         count--;
+      }
+      if (!count)
+         break;
+      ssize_t written = writev(fd, next, count);
+      if (written < 0) {
+         if (errno == EINTR)
+            continue;
+         return -errno;
+      }
+      if (!written)
+         return -EIO;
+      size_t consumed = (size_t)written;
+      while (count && consumed >= next->iov_len) {
+         consumed -= next->iov_len;
+         next++;
+         count--;
+      }
+      if (count && consumed) {
+         next->iov_base = (char *)next->iov_base + consumed;
+         next->iov_len -= consumed;
+      }
+   }
+   return 0;
+}
+#endif
