+/* Opt-in experiment: coalesce only the header/body of the SAME command.
+ * Callers retain socket_mutex through request/reply; no commands are batched.
+ */
+static pthread_once_t winehua_vtest_write_once = PTHREAD_ONCE_INIT;
+static pthread_once_t winehua_vtest_receipt_once = PTHREAD_ONCE_INIT;
+static bool winehua_vtest_packed_write;
+
+static void
+winehua_vtest_init_write(void)
+{
+   const char *value = getenv("VIRGL_WINEHUA_PACKED_WRITE");
+   winehua_vtest_packed_write = value && !strcmp(value, "1");
+}
+
+static void
+winehua_vtest_log_write(void)
+{
+   const char *path = getenv("VIRGL_WINEHUA_TRANSPORT_LOG");
+   FILE *log = path && path[0] ? fopen(path, "a") : NULL;
+   FILE *out = log ? log : stderr;
+   fprintf(out, "WineHuaVirglWrite: packed=%u transport=%s sameCommand=1\n",
+           winehua_vtest_packed_write,
+           winehua_vtest_packed_write ? "writev" : "two-writes");
+   if (log)
+      fclose(log);
+}
+
+static int
+winehua_vtest_write_command(int fd, const void *header, size_t header_size,
+                            const void *body, size_t body_size)
+{
+   int ret;
+   pthread_once(&winehua_vtest_write_once, winehua_vtest_init_write);
+   pthread_once(&winehua_vtest_receipt_once, winehua_vtest_log_write);
+   if (winehua_vtest_packed_write)
+      return virgl_vtest_write_pair(fd, header, header_size, body, body_size);
+   ret = virgl_block_write(fd, (void *)header, header_size);
+   if (ret < 0)
+      return ret;
+   ret = virgl_block_write(fd, (void *)body, body_size);
+   return ret < 0 ? ret : 0;
+}
