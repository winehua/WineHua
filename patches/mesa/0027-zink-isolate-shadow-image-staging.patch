+/* Only the requested image rectangle reaches the destination. The packed
+ * staging allocation may be flushed in full because it has no sibling users. */
+static void
+zink_winehua_flush_image_staging(struct zink_context *ctx, struct zink_transfer *trans,
+                               const struct pipe_box *box, bool remote_upload)
+{
+   struct pipe_transfer *ptrans = &trans->base.b;
+   struct zink_screen *screen = zink_screen(ctx->base.screen);
+   struct zink_resource *staging = zink_resource(trans->staging_res);
+   struct zink_resource *res = zink_resource(ptrans->resource);
+   if (!staging->obj->coherent || remote_upload) {
+      VkMappedMemoryRange range = zink_resource_init_mem_range(screen, staging->obj,
+         staging->obj->offset, staging->base.b.width0);
+      if (VKSCR(FlushMappedMemoryRanges)(screen->dev, 1, &range) != VK_SUCCESS) {
+         mesa_loge("ZINK: shadow image upload flush failed");
+         screen->device_lost = true;
+         return;
+      }
+   }
+
+   if (!box->x && !box->y && !box->z &&
+       box->width == ptrans->box.width && box->height == ptrans->box.height &&
+       box->depth == ptrans->box.depth) {
+      zink_transfer_copy_bufimage(ctx, res, staging, trans);
+      return;
+   }
+
+   /* zink_copy_image_buffer uses tightly packed rows. A partial flush keeps
+    * the original staging pitch, so emit one block row/layer at a time. */
+   enum pipe_format format = staging->base.b.format;
+   unsigned block_height = util_format_get_blockheight(format);
+   unsigned rows = util_format_get_nblocksy(format, box->height);
+   for (unsigned layer = 0; layer < box->depth; layer++) {
+      for (unsigned row = 0; row < rows; row++) {
+         unsigned y = row * block_height;
+         struct pipe_box copy = {
+            .x = trans->offset + (box->z + layer) * (VkDeviceSize)ptrans->layer_stride +
+                 (box->y / block_height + row) * (VkDeviceSize)ptrans->stride +
+                 util_format_get_stride(format, box->x),
+            .width = box->width,
+            .height = MIN2(block_height, box->height - y),
+            .depth = 1,
+         };
+         zink_copy_image_buffer(ctx, res, staging, ptrans->level,
+            ptrans->box.x + box->x, ptrans->box.y + box->y + y,
+            ptrans->box.z + box->z + layer, ptrans->level, &copy, ptrans->usage);
+      }
+   }
+}
