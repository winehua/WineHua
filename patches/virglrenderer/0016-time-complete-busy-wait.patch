+/* Timings cover the complete handler, including context_finish. The vtest
+ * server dispatches these requests serially. Keep counters on that thread and
+ * emit at most two aggregate lines per five seconds, never one per request.
+ * Diagnostic-only: the existing explicit summary opt-in gates every clock. */
+#ifndef WINEHUA_VTEST_BUSY_DIAGNOSTIC
+#define WINEHUA_VTEST_BUSY_DIAGNOSTIC 0
+#endif
+enum winehua_busy_stage {
+   WINEHUA_BUSY_READ, WINEHUA_BUSY_FINISH, WINEHUA_BUSY_POLL,
+   WINEHUA_BUSY_REPLY, WINEHUA_BUSY_STAGE_COUNT
+};
+struct winehua_busy_sample {
+   bool enabled, wait, finish;
+   uint64_t started, stamp, ns[WINEHUA_BUSY_STAGE_COUNT];
+   uint64_t poll_loops, fd_waits;
+};
+struct winehua_busy_totals {
+   uint64_t calls, finishes, errors, total_ns, max_ns;
+   uint64_t ns[WINEHUA_BUSY_STAGE_COUNT], poll_loops, fd_waits;
+};
+static struct winehua_busy_totals winehua_busy_totals[2];
+static uint64_t winehua_busy_window_ns;
+
+static uint64_t winehua_busy_now_ns(void)
+{
+   struct timespec ts;
+   clock_gettime(CLOCK_MONOTONIC, &ts);
+   return (uint64_t)ts.tv_sec * 1000000000ull + ts.tv_nsec;
+}
+
+static struct winehua_busy_sample winehua_busy_begin(bool enabled)
+{
+   struct winehua_busy_sample sample = { .enabled = enabled };
+   if (enabled) {
+      sample.started = sample.stamp = winehua_busy_now_ns();
+      if (!winehua_busy_window_ns)
+         winehua_busy_window_ns = sample.started;
+   }
+   return sample;
+}
+
+static void winehua_busy_mark(struct winehua_busy_sample *sample,
+                             enum winehua_busy_stage stage)
+{
+   if (sample->enabled) {
+      const uint64_t now = winehua_busy_now_ns();
+      sample->ns[stage] += now - sample->stamp;
+      sample->stamp = now;
+   }
+}
+
+static int winehua_busy_end(struct winehua_busy_sample *sample, int result)
+{
+   if (!sample->enabled)
+      return result;
+   const uint64_t now = winehua_busy_now_ns();
+   const uint64_t elapsed = now - sample->started;
+   struct winehua_busy_totals *t = &winehua_busy_totals[sample->wait];
+   t->calls++;
+   t->finishes += sample->finish;
+   t->errors += result != 0;
+   t->total_ns += elapsed;
+   if (elapsed > t->max_ns)
+      t->max_ns = elapsed;
+   for (unsigned i = 0; i < WINEHUA_BUSY_STAGE_COUNT; i++)
+      t->ns[i] += sample->ns[i];
+   t->poll_loops += sample->poll_loops;
+   t->fd_waits += sample->fd_waits;
+   if (now - winehua_busy_window_ns >= 5000000000ull) {
+      for (unsigned wait = 0; wait < 2; wait++) {
+         t = &winehua_busy_totals[wait];
+         if (!t->calls)
+            continue;
+         winehua_diag("busy summary wait=%u window_ns=%llu calls=%llu finishes=%llu errors=%llu total_ns=%llu max_ns=%llu read_ns=%llu finish_ns=%llu poll_ns=%llu reply_ns=%llu poll_loops=%llu fd_waits=%llu",
+            wait, (unsigned long long)(now - winehua_busy_window_ns),
+            (unsigned long long)t->calls, (unsigned long long)t->finishes,
+            (unsigned long long)t->errors, (unsigned long long)t->total_ns,
+            (unsigned long long)t->max_ns,
+            (unsigned long long)t->ns[WINEHUA_BUSY_READ],
+            (unsigned long long)t->ns[WINEHUA_BUSY_FINISH],
+            (unsigned long long)t->ns[WINEHUA_BUSY_POLL],
+            (unsigned long long)t->ns[WINEHUA_BUSY_REPLY],
+            (unsigned long long)t->poll_loops, (unsigned long long)t->fd_waits);
+      }
+      memset(winehua_busy_totals, 0, sizeof(winehua_busy_totals));
+      winehua_busy_window_ns = now;
+   }
+   return result;
+}
+/* End complete busy-wait diagnostics. */
