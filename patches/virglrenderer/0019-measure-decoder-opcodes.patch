+/* Begin bounded decoder diagnostics. No clocks in ordinary builds. */
+#ifndef WINEHUA_VIRGL_OPCODE_DIAGNOSTIC
+#define WINEHUA_VIRGL_OPCODE_DIAGNOSTIC 0
+#endif
+#define WINEHUA_OPCODE_SWITCH VIRGL_MAX_COMMANDS
+#define WINEHUA_OPCODE_CHECK (VIRGL_MAX_COMMANDS + 1)
+#define WINEHUA_OPCODE_COUNT (VIRGL_MAX_COMMANDS + 2)
+#if WINEHUA_VIRGL_OPCODE_DIAGNOSTIC
+#include <time.h>
+struct winehua_opcode_stat { uint64_t calls, ns, max_ns, bytes; };
+static struct winehua_opcode_stat winehua_opcode_stats[WINEHUA_OPCODE_COUNT];
+static struct winehua_opcode_stat winehua_opcode_batches;
+static uint64_t winehua_opcode_window;
+static uint64_t winehua_opcode_begin(void)
+{
+   struct timespec ts;
+   clock_gettime(CLOCK_MONOTONIC, &ts);
+   return (uint64_t)ts.tv_sec * 1000000000ull + ts.tv_nsec;
+}
+static void winehua_opcode_add(struct winehua_opcode_stat *s, uint64_t elapsed, uint64_t bytes)
+{
+   s->calls++;
+   s->ns += elapsed;
+   s->bytes += bytes;
+   if (elapsed > s->max_ns)
+      s->max_ns = elapsed;
+}
+static void winehua_opcode_end(unsigned op, uint64_t started, uint64_t bytes)
+{
+   winehua_opcode_add(&winehua_opcode_stats[op], winehua_opcode_begin() - started, bytes);
+}
+static void winehua_opcode_finish(uint64_t started, size_t bytes)
+{
+   const uint64_t now = winehua_opcode_begin();
+   winehua_opcode_add(&winehua_opcode_batches, now - started, bytes);
+   if (!winehua_opcode_window)
+      winehua_opcode_window = started;
+   if (now - winehua_opcode_window < 5000000000ull)
+      return;
+   const uint64_t window = now - winehua_opcode_window;
+   /* At most VIRGL_MAX_COMMANDS + 3 lines per five-second window. */
+   virgl_warn("opcode batch window_ns=%llu calls=%llu total_ns=%llu max_ns=%llu bytes=%llu\n",
+      (unsigned long long)window, (unsigned long long)winehua_opcode_batches.calls,
+      (unsigned long long)winehua_opcode_batches.ns, (unsigned long long)winehua_opcode_batches.max_ns,
+      (unsigned long long)winehua_opcode_batches.bytes);
+   for (unsigned op = 0; op < WINEHUA_OPCODE_COUNT; op++) {
+      struct winehua_opcode_stat *s = &winehua_opcode_stats[op];
+      if (!s->calls)
+         continue;
+      const char *name = op == WINEHUA_OPCODE_SWITCH ? "context-switch" :
+                         op == WINEHUA_OPCODE_CHECK ? "gl-error-check" : vrend_get_comand_name(op);
+      virgl_warn("opcode summary op=%u name=%s window_ns=%llu calls=%llu total_ns=%llu max_ns=%llu bytes=%llu\n",
+         op, name, (unsigned long long)window, (unsigned long long)s->calls,
+         (unsigned long long)s->ns, (unsigned long long)s->max_ns, (unsigned long long)s->bytes);
+   }
+   memset(winehua_opcode_stats, 0, sizeof(winehua_opcode_stats));
+   memset(&winehua_opcode_batches, 0, sizeof(winehua_opcode_batches));
+   winehua_opcode_window = now;
+}
+#else
+static inline uint64_t winehua_opcode_begin(void) { return 0; }
+static inline void winehua_opcode_end(unsigned op, uint64_t started, uint64_t bytes)
+{ (void)op; (void)started; (void)bytes; }
+static inline void winehua_opcode_finish(uint64_t started, size_t bytes)
+{ (void)started; (void)bytes; }
+#endif
+/* End bounded decoder diagnostics. */
