+/* Begin immutable framebuffer completeness cache helpers. */
+static inline void winehua_fbo_status_reset(struct vrend_sub_context *sub_ctx)
+{
+#if WINEHUA_VIRGL_FBO_STATUS_CACHE
+   sub_ctx->fbo_status_cache.count = 0;
+   sub_ctx->fbo_status_cache.next = 0;
+#else
+   (void)sub_ctx;
+#endif
+}
+
+#if WINEHUA_VIRGL_FBO_STATUS_CACHE
+static bool winehua_fbo_status_key(struct vrend_sub_context *sub_ctx,
+                                  struct winehua_fbo_status_key *key)
+{
+   memset(key, 0, sizeof(*key));
+   key->nr_cbufs = sub_ctx->nr_cbufs;
+   key->depth = sub_ctx->zsurf;
+   bool attached = false;
+   for (unsigned i = 0; i <= sub_ctx->nr_cbufs; i++) {
+      const struct vrend_surface *surf = i == sub_ctx->nr_cbufs ?
+                                       sub_ctx->zsurf : sub_ctx->surf[i];
+      if (i < sub_ctx->nr_cbufs)
+         key->color[i] = surf;
+      if (!surf)
+         continue;
+      const struct vrend_resource *res = surf->texture;
+      /* Import/storage changes and mip selection need fresh driver validation.
+       * Cache only internally allocated, immutable, single-level textures.
+       * No resource references are retained by this cache. */
+      const uint32_t external = VREND_STORAGE_EGL_IMAGE | VREND_STORAGE_GBM_BUFFER |
+                                VREND_STORAGE_GL_MEMOBJ | VREND_STORAGE_D3D_TEXTURE;
+      if (!has_bit(res->storage_bits, VREND_STORAGE_GL_IMMUTABLE) ||
+          has_bit(res->storage_bits, external) || res->egl_image || res->gbm_bo ||
+          res->base.last_level || surf->level)
+         return false;
+      attached = true;
+   }
+   return attached;
+}
+
+#endif
+
+static bool winehua_fbo_status_cached(struct vrend_sub_context *sub_ctx)
+{
+#if WINEHUA_VIRGL_FBO_STATUS_CACHE
+   struct winehua_fbo_status_key key;
+   if (!winehua_fbo_status_key(sub_ctx, &key))
+      return false;
+   for (unsigned i = 0; i < sub_ctx->fbo_status_cache.count; i++) {
+      if (!memcmp(&key, &sub_ctx->fbo_status_cache.keys[i], sizeof(key)))
+         return true;
+   }
+#else
+   (void)sub_ctx;
+#endif
+   return false;
+}
+
+static void winehua_fbo_status_remember(struct vrend_sub_context *sub_ctx)
+{
+#if WINEHUA_VIRGL_FBO_STATUS_CACHE
+   struct winehua_fbo_status_key key;
+   if (!winehua_fbo_status_key(sub_ctx, &key))
+      return;
+   struct winehua_fbo_status_cache *cache = &sub_ctx->fbo_status_cache;
+   cache->keys[cache->next] = key;
+   cache->next = (cache->next + 1) % WINEHUA_FBO_STATUS_ENTRIES;
+   if (cache->count < WINEHUA_FBO_STATUS_ENTRIES)
+      cache->count++;
+#else
+   (void)sub_ctx;
+#endif
+}
+/* End immutable framebuffer completeness cache helpers. */
