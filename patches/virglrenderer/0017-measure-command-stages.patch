 /* End complete busy-wait diagnostics. */
 
+/* Compile-time-only stage diagnostics; ordinary builds execute no clocks. */
+#ifndef WINEHUA_VTEST_COMMAND_DIAGNOSTIC
+#define WINEHUA_VTEST_COMMAND_DIAGNOSTIC 0
+#endif
+enum winehua_command_stage {
+   WINEHUA_COMMAND_READ, WINEHUA_COMMAND_EXECUTE, WINEHUA_COMMAND_FENCE,
+   WINEHUA_COMMAND_GET, WINEHUA_COMMAND_PUT, WINEHUA_COMMAND_COUNT
+};
+struct winehua_command_total { uint64_t calls, ns, max_ns, bytes; };
+static struct winehua_command_total winehua_command_totals[WINEHUA_COMMAND_COUNT];
+static uint64_t winehua_command_window;
+static uint64_t winehua_command_begin(void)
+{
+   return WINEHUA_VTEST_COMMAND_DIAGNOSTIC ? winehua_busy_now_ns() : 0;
+}
+static void winehua_command_end(enum winehua_command_stage stage,
+                                uint64_t started, uint64_t bytes)
+{
+   if (!WINEHUA_VTEST_COMMAND_DIAGNOSTIC)
+      return;
+   const uint64_t now = winehua_busy_now_ns();
+   const uint64_t elapsed = now - started;
+   struct winehua_command_total *t = &winehua_command_totals[stage];
+   if (!winehua_command_window)
+      winehua_command_window = started;
+   t->calls++;
+   t->ns += elapsed;
+   t->bytes += bytes;
+   if (elapsed > t->max_ns)
+      t->max_ns = elapsed;
+   if (now - winehua_command_window >= 5000000000ull) {
+      static const char *names[] = { "submit-read", "submit-execute", "submit-fence", "transfer-get", "transfer-put" };
+      for (unsigned i = 0; i < WINEHUA_COMMAND_COUNT; i++) {
+         t = &winehua_command_totals[i];
+         if (t->calls)
+            winehua_diag("command summary stage=%s window_ns=%llu calls=%llu total_ns=%llu max_ns=%llu bytes=%llu",
+               names[i], (unsigned long long)(now - winehua_command_window),
+               (unsigned long long)t->calls, (unsigned long long)t->ns,
+               (unsigned long long)t->max_ns, (unsigned long long)t->bytes);
+      }
+      memset(winehua_command_totals, 0, sizeof(winehua_command_totals));
+      winehua_command_window = now;
+   }
+}
+
