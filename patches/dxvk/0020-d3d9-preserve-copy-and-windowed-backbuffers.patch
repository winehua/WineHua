+  bool D3D9SwapChainEx::HasFrontBuffer() const {
+    if (m_parent->GetOptions()->noExplicitFrontBuffer)
+      return false;
+
+    // Backport the buffer-preservation part of upstream feebec959d3d.
+    // COPY keeps the backbuffer, and native windowed DISCARD with one
+    // backbuffer behaves the same way. Rotating an extra black frontbuffer
+    // here breaks games which retain their previous frame contents.
+    if (m_presentParams.SwapEffect == D3DSWAPEFFECT_COPY
+     || m_presentParams.SwapEffect == D3DSWAPEFFECT_COPY_VSYNC)
+      return false;
+
+    return !(m_presentParams.SwapEffect == D3DSWAPEFFECT_DISCARD
+          && m_presentParams.BackBufferCount == 1
+          && m_presentParams.Windowed);
+  }
+
