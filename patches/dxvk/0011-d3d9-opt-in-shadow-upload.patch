 namespace dxvk {
+
+  // Match the D3D11 shadow-memory publication contract. The buffer has
+  // already been written; the CS owns its physical slice at this point.
+  static void PublishD3D9ShadowUpload(DxvkContext* ctx,
+      const Rc<DxvkBuffer>& buffer, const DxvkBufferSliceHandle& slice) {
+    static const bool enabled = env::getEnvVar("WINEHUA_DXVK9_SHADOW_UPLOAD") == "1";
+    if (enabled && ctx->flushMappedBuffer(buffer, slice) != VK_SUCCESS)
+      throw DxvkError("D3D9: shadow upload publication failed");
+  }
