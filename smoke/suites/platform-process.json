{
  "name": "platform-process",
  "title": "跨架构进程创建（x64 与 x86 互为 peer，IPC 往返）",
  "tests": [
    {
      "case": "platform-process",
      "id": "platform-process",
      "arch": [
        "x64"
      ],
      "backend": {
        "d3d": "wined3d"
      },
      "env": {
        "WINEHUA_PEER_EXE": "C:/smoke/x86/winehua_platform_process_smoke.exe",
        "WINEHUA_PEER_ARCH": "x86"
      },
      "seconds": 0,
      "timeoutMs": 120000
    },
    {
      "case": "platform-process",
      "id": "platform-process",
      "arch": [
        "x86"
      ],
      "backend": {
        "d3d": "wined3d"
      },
      "env": {
        "WINEHUA_PEER_EXE": "C:/smoke/x64/winehua_platform_process_smoke.exe",
        "WINEHUA_PEER_ARCH": "$wine_x64_arch"
      },
      "seconds": 0,
      "timeoutMs": 120000
    }
  ]
}
