{
  "name": "steam-font",
  "title": "Steam 字体契约（DirectWrite 枚举/渲染，i386 与 AMD64 真 PE）",
  "tests": [
    {
      "case": "font-i386",
      "id": "font",
      "arch": [
        "x86"
      ],
      "backend": {
        "d3d": "wined3d"
      },
      "env": {},
      "argvMode": "raw",
      "argv": [
        "--output",
        "C:/smoke/results/<run-id>/<test-id>.json"
      ],
      "timeoutMs": 60000
    },
    {
      "case": "font-amd64",
      "id": "font",
      "arch": [
        "x64"
      ],
      "backend": {
        "d3d": "wined3d"
      },
      "env": {},
      "argvMode": "raw",
      "argv": [
        "--output",
        "C:/smoke/results/<run-id>/<test-id>.json"
      ],
      "timeoutMs": 60000
    }
  ]
}
