{
  "id": "gdi-primitives",
  "title": "GDI图元绘制读回（矩形/线/椭圆）",
  "exe": "gdi_primitives.exe",
  "arch": [
    "x64",
    "x86"
  ],
  "build": {
    "sources": [
      "smoke/programs/gdi/gdi_primitives.c"
    ],
    "cflags": [
      "-O2",
      "-s",
      "-Ithirdparty/wine/programs"
    ],
    "libs": [
      "-luser32",
      "-lgdi32"
    ]
  }
}
