{
  "id": "dxvk26-requirements",
  "title": "DXVK 2.6.2 所需 Guest/Wine Vulkan 1.3 transport 资格 probe",
  "exe": "winehua_dxvk26_requirements.exe",
  "arch": [
    "x64",
    "x86"
  ],
  "build": {
    "sources": [
      "smoke/winehua_dxvk26_requirements.c"
    ],
    "cflags": [
      "-O2",
      "-s",
      "-Wall",
      "-Wextra",
      "-Werror"
    ],
    "dxvk_include": true,
    "vulkan_import": true,
    "libs": [
      "-luser32",
      "-lcomctl32",
      "-lgdi32"
    ]
  }
}
