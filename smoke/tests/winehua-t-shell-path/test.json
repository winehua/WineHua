{
  "id": "winehua-t-shell-path",
  "title": "系统路径映射与可写性（profile回归哨兵）",
  "exe": "winehua_t_shell_path.exe",
  "arch": [
    "x64",
    "x86"
  ],
  "build": {
    "sources": [
      "smoke/t/shell/shell_path.c"
    ],
    "cflags": [
      "-O2",
      "-s",
      "-Ithirdparty/wine/programs"
    ],
    "libs": [
      "-luser32",
      "-lshell32"
    ]
  }
}
