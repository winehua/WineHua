{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": [
      "phone",
      "2in1",
      "tablet"
    ],
    "compressNativeLibs": false,
    "requestPermissions": [
      {
        "name": "ohos.permission.kernel.ALLOW_WRITABLE_CODE_MEMORY"
      },
      {
        "name": "ohos.permission.INTERNET"
      },
      {
        // 游戏相对模式 (dinput 无限转视角) 时锁定/冻结系统光标;
        // normal 级 system_grant, 声明即可, 无弹窗
        "name": "ohos.permission.LOCK_WINDOW_CURSOR"
      },
      {
        "name": "ohos.permission.MICROPHONE",
        "reason": "$string:microphone_permission",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "always"
        }
      }
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:layered_image",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "launchType": "singleton",
        // Probe UI: allow phone portrait/landscape. Master still forces
        // landscape for dedicated game windows via compositor/window policy.
        "orientation": "auto_rotation",
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "ohos.want.action.home"
            ]
          }
        ]
      },
      {
        "name": "DesktopAbility",
        "srcEntry": "./ets/entryability/DesktopAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:layered_image",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        "exported": false,
        "launchType": "singleton",
        "orientation": "auto_rotation",
        "removeMissionAfterTerminate": true
      },
      {
        "name": "WineWindowAbility",
        "srcEntry": "./ets/entryability/WineWindowAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:layered_image",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        "exported": false,
        "launchType": "multiton",
        "orientation": "auto_rotation",
        "removeMissionAfterTerminate": true
      },
      {
        "name": "VirtualDesktopAbility",
        "srcEntry": "./ets/entryability/VirtualDesktopAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:layered_image",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        "exported": false,
        "launchType": "singleton",
        "removeMissionAfterTerminate": true
      }
    ]
  }
}
