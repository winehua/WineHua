{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    // 不含 "phone": 本模块用到仅 2in1/tablet 提供的系统能力, 与 phone 的 syscap
    // 集交集为空, 带上 phone 会让 hvigor 直接构建失败 —
    // "The intersection of the system capability sets configured for multiple
    // devices is empty" (2026-09-12 实测, 加回 phone 立即复现)。
    // 另: Release 打包流程 (见 .claude/rules/local.md 第 1 步) 同样要求去掉 phone。
    "deviceTypes": [
      "2in1",
      "tablet"
    ],
    "compressNativeLibs": false,
    "requestPermissions": [
      {
        "name": "ohos.permission.kernel.ALLOW_WRITABLE_CODE_MEMORY"
      },
      {
        "name": "ohos.permission.INTERNET"
      },
      {
        // 游戏相对模式 (dinput 无限转视角) 时锁定/冻结系统光标;
        // normal 级 system_grant, 声明即可, 无弹窗
        "name": "ohos.permission.LOCK_WINDOW_CURSOR"
      },
      {
        "name": "ohos.permission.MICROPHONE",
        "reason": "$string:microphone_permission",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "always"
        }
      }
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:layered_image",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "launchType": "singleton",
        // 强制横屏 (宽屏设备保持宽>高不旋转, 直板机转横屏):
        // 参考官方窗口旋转指南 — 固定方向类型 LANDSCAPE, 游戏类应用标准做法
        "orientation": "landscape",
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "ohos.want.action.home"
            ]
          }
        ]
      },
      {
        "name": "WineWindowAbility",
        "srcEntry": "./ets/entryability/WineWindowAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:layered_image",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        "exported": false,
        "launchType": "multiton",
        "orientation": "landscape",
        "removeMissionAfterTerminate": true
      },
      {
        "name": "VirtualDesktopAbility",
        "srcEntry": "./ets/entryability/VirtualDesktopAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:layered_image",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        "exported": false,
        "launchType": "singleton",
        "orientation": "landscape",
        "removeMissionAfterTerminate": true
      }
    ]
  }
}
