+// WineHua (D25-B): scene damage 台账插桩。旗标文件与宿主侧 DiagFlagFile
+// 同一个 (.wine/drive_c/scene-damage-diag), 1s 缓存, 关闭时近零开销。
+// 三个记账点: surface commit (客户端提交到达?) / scene_output_damage
+// (damage 产生并入账?) / output commit (damage 被消费 + pending 余量)。
+// 坏变体指纹「seq 推进而 needsFrame=0」出现时, 对账三点定位断跳。
+static bool scene_damage_diag_enabled(void) {
+	static bool cached = false;
+	static int64_t last_ms = 0;
+	int64_t now = get_current_time_msec();
+	if (now - last_ms >= 1000) {
+		last_ms = now;
+		cached = access("/data/storage/el2/base/files/.wine/drive_c/scene-damage-diag",
+			F_OK) == 0;
+	}
+	return cached;
+}
+
+static void scene_damage_diag_log_damage(struct wlr_scene_output *scene_output,
+		const pixman_region32_t *clipped) {
+	if (pixman_region32_empty(clipped)) {
+		wlr_log(WLR_INFO, "[D25B] dmg out=%s clipped=EMPTY",
+			scene_output->output->name);
+		return;
+	}
+	pixman_box32_t *c = pixman_region32_extents(clipped);
+	if (pixman_region32_empty(&scene_output->pending_commit_damage)) {
+		wlr_log(WLR_INFO, "[D25B] dmg out=%s rect=%dx%d@%d,%d pending=EMPTY",
+			scene_output->output->name,
+			c->x2 - c->x1, c->y2 - c->y1, c->x1, c->y1);
+		return;
+	}
+	pixman_box32_t *p =
+		pixman_region32_extents(&scene_output->pending_commit_damage);
+	wlr_log(WLR_INFO, "[D25B] dmg out=%s rect=%dx%d@%d,%d pending=%dx%d@%d,%d",
+		scene_output->output->name,
+		c->x2 - c->x1, c->y2 - c->y1, c->x1, c->y1,
+		p->x2 - p->x1, p->y2 - p->y1, p->x1, p->y1);
+}
