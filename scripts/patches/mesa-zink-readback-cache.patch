+      /* Cache only idle synchronous readback staging. Hold one bounded
+       * allocation per context; concurrent maps retain their own resource.
+       * Keep all existing transfer barriers, fence waits and invalidates. */
+      const bool cache_readback = (usage & PIPE_MAP_READ) &&
+         !(usage & PIPE_MAP_WRITE) && templ.width0 <= 16 * 1024 * 1024 &&
+         debug_get_bool_option("ZINK_WINEHUA_READBACK_CACHE", false);
+      const bool cached_idle = ctx->winehua_readback_staging &&
