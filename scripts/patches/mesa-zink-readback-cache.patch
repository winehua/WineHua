+         zink_resource_usage_check_completion(screen,
+            zink_resource(ctx->winehua_readback_staging), ZINK_RESOURCE_ACCESS_RW);
+      if (cache_readback && cached_idle &&
+          ctx->winehua_readback_staging->format == templ.format &&
+          ctx->winehua_readback_staging->width0 >= templ.width0) {
+         pipe_resource_reference(&trans->staging_res, ctx->winehua_readback_staging);
+      } else {
+         trans->staging_res = zink_resource_create(pctx->screen, &templ);
+         if (cache_readback && trans->staging_res &&
+             (!ctx->winehua_readback_staging || cached_idle))
+            pipe_resource_reference(&ctx->winehua_readback_staging, trans->staging_res);
