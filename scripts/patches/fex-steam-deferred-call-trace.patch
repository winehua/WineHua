+std::array<SteamCallRecord, 4096> SteamCallRecords;
+std::atomic<uint32_t> SteamCallSeen {};
+uint32_t SteamCallRead {};
 std::array<SteamBoundaryRecord, 1024> SteamBoundaryRecords;
 std::atomic<uint32_t> SteamBoundaryWrite {};
 std::atomic_flag SteamBoundaryFlushing = ATOMIC_FLAG_INIT;
@@ -110,4 +122,15 @@ void FlushSteamBoundaries() {
     __wine_dbg_output(message);
   }
+  while (SteamCallRead < SteamCallRecords.size() &&
+         SteamCallRecords[SteamCallRead].ready.load(std::memory_order_acquire)) {
+    const auto& record = SteamCallRecords[SteamCallRead++];
