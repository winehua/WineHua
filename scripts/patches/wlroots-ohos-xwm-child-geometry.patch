+ * here — hosts track those via the new_surface/associate events.
+ */
+bool wlr_xwayland_query_child_geometry(struct wlr_xwayland *wlr_xwayland,
+	xcb_window_t window_id, int32_t *x, int32_t *y,
+	uint32_t *width, uint32_t *height, uint64_t *generation);
+
+/**
+ * WineHua (D31): CLIENT area of a child window of a managed toplevel,
+ * honoring the client-declared _NET_WM_FRAME_EXTENTS ([left,right,top,
+ * bottom] EWMH insets — wine desktop mode draws its own decorations).
+ * Falls back to the full window rect when the client declares no insets.
+ * Same liveness/generation contract as query_child_geometry().
+ */
+bool wlr_xwayland_query_child_client_area(struct wlr_xwayland *wlr_xwayland,
+	xcb_window_t window_id, int32_t *x, int32_t *y,
+	uint32_t *width, uint32_t *height, uint64_t *generation);
+
