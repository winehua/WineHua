+// WineHua (D23): geometry of children of MANAGED windows. Wine's virtual
+// desktop hosts every app window as an X child of the desktop toplevel; the
+// host compositor anchors zero-copy guest frames by window id and needs their
+// on-root geometry. We deliberately do NOT create wlr_xwayland_surface for
+// children (xwm must not manage/restack them) — this table is geometry only.
+struct xwm_child_window {
+	xcb_window_t window_id;
+	struct wlr_xwayland_surface *parent; // managed toplevel
+	int16_t x, y; // parent-relative (absolute = parent->x/y + rel, computed
+	              // at query time so toplevel moves need no per-child events)
+	uint16_t width, height;
+	uint64_t generation; // monotonic per (re)creation; query fail = gone
+	// WineHua (D31): client-area insets declared by the client itself via
+	// _NET_WM_FRAME_EXTENTS ([left,right,top,bottom], EWMH). Wine desktop
+	// mode draws its own decorations, so only the client knows them; the
+	// host anchors zero-copy faces at the client rect. Unknown until the
+	// property is seen — queries then fall back to the full window rect,
+	// which is exact for borderless children.
+	int16_t frame_l, frame_r, frame_t, frame_b;
+	bool frame_known;
+	struct wl_list link;
+};
+
+static uint64_t xwm_child_generation_next = 1;
+
+static struct xwm_child_window *xwm_child_window_find(struct wlr_xwm *xwm,
+		xcb_window_t window_id) {
+	struct xwm_child_window *child;
+	wl_list_for_each(child, &xwm->child_windows, link) {
+		if (child->window_id == window_id) {
+			return child;
+		}
+	}
+	return NULL;
+}
+
+// WineHua (D31): refresh the cached _NET_WM_FRAME_EXTENTS of a child.
+// Synchronous round trip — called once per child creation and then only on
+// PropertyNotify, never per frame.
+static void xwm_child_window_read_frame_extents(struct wlr_xwm *xwm,
+		struct xwm_child_window *child) {
+	xcb_get_property_cookie_t cookie = xcb_get_property(xwm->xcb_conn, 0,
+		child->window_id, xwm->atoms[NET_WM_FRAME_EXTENTS],
+		XCB_ATOM_CARDINAL, 0, 4);
+	xcb_get_property_reply_t *reply =
+		xcb_get_property_reply(xwm->xcb_conn, cookie, NULL);
+	if (reply == NULL) {
+		return;
+	}
+	if (reply->type == XCB_ATOM_CARDINAL && xcb_get_property_value_length(reply) >= 16) {
+		int32_t *v = xcb_get_property_value(reply);
+		child->frame_l = v[0] > 0 ? v[0] : 0;
+		child->frame_r = v[1] > 0 ? v[1] : 0;
+		child->frame_t = v[2] > 0 ? v[2] : 0;
+		child->frame_b = v[3] > 0 ? v[3] : 0;
+		child->frame_known = true;
+	} else {
+		// absent or malformed: declare unknown, not zero — a stale insets
+		// cache would misplace the face after the client drops decorations
+		child->frame_known = false;
+	}
+	free(reply);
+}
+
+static void xwm_child_window_add(struct wlr_xwm *xwm,
+		struct wlr_xwayland_surface *parent, xcb_create_notify_event_t *ev) {
+	struct xwm_child_window *child = calloc(1, sizeof(*child));
+	if (!child) {
+		return;
+	}
+	child->window_id = ev->window;
+	child->parent = parent;
+	child->x = ev->x;
+	child->y = ev->y;
+	child->width = ev->width;
+	child->height = ev->height;
+	child->generation = xwm_child_generation_next++;
+	wl_list_insert(&xwm->child_windows, &child->link);
+
+	// WineHua (D31): the frame-extents property may or may not exist yet
+	// when CreateNotify arrives (wine writes it between create and map, we
+	// race with that). Order-safe either way: the PropertyChangeMask
+	// selection below is issued on the wire BEFORE the read, so a property
+	// write landing after the read hits the already-active mask and comes
+	// back as PropertyNotify; one landing before the read is simply read.
+	uint32_t mask_values[1] = {XCB_EVENT_MASK_PROPERTY_CHANGE};
+	xcb_change_window_attributes(xwm->xcb_conn, child->window_id,
+		XCB_CW_EVENT_MASK, mask_values);
+	xwm_child_window_read_frame_extents(xwm, child);
+}
+
+static void xwm_child_window_remove(struct wlr_xwm *xwm,
+		xcb_window_t window_id) {
+	struct xwm_child_window *child = xwm_child_window_find(xwm, window_id);
+	if (child) {
+		wl_list_remove(&child->link);
+		free(child);
+	}
+}
+
+void xwm_child_window_remove_all(struct wlr_xwm *xwm,
+		struct wlr_xwayland_surface *parent) {
+	struct xwm_child_window *child, *tmp;
+	wl_list_for_each_safe(child, tmp, &xwm->child_windows, link) {
+		if (child->parent == parent) {
+			wl_list_remove(&child->link);
+			free(child);
+		}
+	}
+}
+
