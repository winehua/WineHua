+
+bool wlr_xwayland_query_child_geometry(struct wlr_xwayland *wlr_xwayland,
+		xcb_window_t window_id, int32_t *x, int32_t *y,
+		uint32_t *width, uint32_t *height, uint64_t *generation) {
+	struct wlr_xwm *xwm = wlr_xwayland->xwm;
+	if (!xwm) {
+		return false;
+	}
+	struct xwm_child_window *child = xwm_child_window_find(xwm, window_id);
+	if (!child) {
+		return false;
+	}
+	if (x) {
+		*x = (int32_t)child->parent->x + child->x;
+	}
+	if (y) {
+		*y = (int32_t)child->parent->y + child->y;
+	}
+	if (width) {
+		*width = child->width;
+	}
+	if (height) {
+		*height = child->height;
+	}
+	if (generation) {
+		*generation = child->generation;
+	}
+	return true;
+}
+
+bool wlr_xwayland_query_child_client_area(struct wlr_xwayland *wlr_xwayland,
+		xcb_window_t window_id, int32_t *x, int32_t *y,
+		uint32_t *width, uint32_t *height, uint64_t *generation) {
+	struct wlr_xwm *xwm = wlr_xwayland->xwm;
+	if (!xwm) {
+		return false;
+	}
+	struct xwm_child_window *child = xwm_child_window_find(xwm, window_id);
+	if (!child) {
+		return false;
+	}
+	// WineHua (D31): insets declared by the client via _NET_WM_FRAME_EXTENTS.
+	// Without a declaration (borderless child, or the property has not
+	// landed yet) the client area IS the full window rect — same placement
+	// the pre-D31 face anchoring used, so behavior degrades gracefully.
+	int32_t l = child->frame_known ? child->frame_l : 0;
+	int32_t t = child->frame_known ? child->frame_t : 0;
+	int32_t r = child->frame_known ? child->frame_r : 0;
+	int32_t b = child->frame_known ? child->frame_b : 0;
+	int32_t cw = (int32_t)child->width - l - r;
+	int32_t ch = (int32_t)child->height - t - b;
+	if (x) {
+		*x = (int32_t)child->parent->x + child->x + l;
+	}
+	if (y) {
+		*y = (int32_t)child->parent->y + child->y + t;
+	}
+	if (width) {
+		*width = cw > 1 ? cw : 1;
+	}
+	if (height) {
+		*height = ch > 1 ? ch : 1;
+	}
+	if (generation) {
+		*generation = child->generation;
+	}
+	return true;
+}
