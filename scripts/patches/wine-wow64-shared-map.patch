+    else if (memory->wow64_copy) wow64_map_perf.copy_total++;
+    else if (memory->wow64_alias) wow64_map_perf.alias_total++;
+    else wow64_map_perf.direct_total++; /* Includes placed/external-host maps. */
+    pthread_mutex_unlock( &wow64_copy_mutex );
+}
