diff --git a/dlls/win32u/winehua_shared_map.h b/dlls/win32u/winehua_shared_map.h
new file mode 100644
index 00000000000..fd5b9b62f23
--- /dev/null
+++ b/dlls/win32u/winehua_shared_map.h
@@ -0,0 +1,156 @@
+/* WineHua: alias a live shared Vulkan mapping into a Wine-owned reservation.
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+#ifndef WINEHUA_SHARED_MAP_H
+#define WINEHUA_SHARED_MAP_H
+
+#include <dirent.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <inttypes.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <sys/mman.h>
+#include <sys/stat.h>
+#include <sys/sysmacros.h>
+#include <unistd.h>
+
+struct winehua_shared_vma
+{
+    uintptr_t start, end;
+    uint64_t offset, inode;
+    unsigned int dev_major, dev_minor;
+};
+
+static const char *winehua_shared_map_last_stage = "uninitialized";
+
+static const char *winehua_shared_map_stage(void)
+{
+    return winehua_shared_map_last_stage;
+}
+
+static int winehua_shared_fd_matches( int fd, const struct winehua_shared_vma *vma )
+{
+    struct stat st;
+    int flags = fcntl( fd, F_GETFL );
+    return flags >= 0 && (flags & O_ACCMODE) == O_RDWR && !fstat( fd, &st ) &&
+           (S_ISREG( st.st_mode ) || S_ISCHR( st.st_mode )) &&
+           (uint64_t)st.st_ino == vma->inode &&
+           major( st.st_dev ) == vma->dev_major && minor( st.st_dev ) == vma->dev_minor;
+}
+
+static int winehua_shared_map_fd( const void *host, size_t size, off_t *file_offset )
+{
+    struct winehua_shared_vma vma;
+    uintptr_t address = (uintptr_t)host;
+    struct dirent *entry;
+    FILE *maps;
+    DIR *fds;
+    char line[512], path[128];
+    int found = 0, fd = -1;
+    uint64_t offset;
+
+    if (!size || size > UINTPTR_MAX - address)
+    {
+        winehua_shared_map_last_stage = "validate";
+        errno = EINVAL;
+        return -1;
+    }
+    winehua_shared_map_last_stage = "maps-open";
+    if (!(maps = fopen( "/proc/self/maps", "r" ))) return -1;
+    while (fgets( line, sizeof(line), maps ))
+    {
+        char perms[8];
+        if (sscanf( line, "%" SCNxPTR "-%" SCNxPTR " %7s %" SCNx64 " %x:%x %" SCNu64,
+                    &vma.start, &vma.end, perms, &vma.offset,
+                    &vma.dev_major, &vma.dev_minor, &vma.inode ) != 7) continue;
+        if (address >= vma.start && address + size <= vma.end &&
+            perms[0] == 'r' && perms[1] == 'w' && perms[3] == 's' && vma.inode)
+        {
+            found = 1;
+            break;
+        }
+    }
+    fclose( maps );
+    if (!found)
+    {
+        winehua_shared_map_last_stage = "shared-vma";
+        errno = ENOENT;
+        return -1;
+    }
+    offset = vma.offset + (address - vma.start);
+    if (offset < vma.offset || (off_t)offset < 0 || (uint64_t)(off_t)offset != offset)
+    {
+        winehua_shared_map_last_stage = "file-offset";
+        errno = EOVERFLOW;
+        return -1;
+    }
+
+    /* Prefer a duplicate of the live BO fd. map_files often requires a
+     * privilege that application sandboxes do not have. Duplicate before
+     * fstat, so a concurrently reused fd cannot pass an obsolete check. */
+    winehua_shared_map_last_stage = "live-fd";
+    if ((fds = opendir( "/proc/self/fd" )))
+    {
+        while ((entry = readdir( fds )))
+        {
+            if (entry->d_name[0] < '0' || entry->d_name[0] > '9') continue;
+            fd = fcntl( atoi( entry->d_name ), F_DUPFD_CLOEXEC, 0 );
+            if (fd < 0) continue;
+            if (winehua_shared_fd_matches( fd, &vma )) break;
+            close( fd );
+            fd = -1;
+        }
+        closedir( fds );
+    }
+    if (fd < 0)
+    {
+        winehua_shared_map_last_stage = "map-files";
+        snprintf( path, sizeof(path), "/proc/self/map_files/%" PRIxPTR "-%" PRIxPTR, vma.start, vma.end );
+        fd = open( path, O_RDWR | O_CLOEXEC );
+        if (fd >= 0 && !winehua_shared_fd_matches( fd, &vma ))
+        {
+            close( fd );
+            fd = -1;
+            winehua_shared_map_last_stage = "map-files-identity";
+            errno = ENOENT;
+        }
+    }
+    if (fd >= 0)
+    {
+        winehua_shared_map_last_stage = "alias-mmap";
+        *file_offset = (off_t)offset;
+    }
+    return fd;
+}
+
+/* placed must be an exclusive reservation owned by the caller. Only that
+ * reservation is replaced; the original host VMA is never moved or probed
+ * with writes. Both views use the exact same backing file and byte offset. */
+static int winehua_shared_map_alias( const void *host, size_t size, void *placed )
+{
+    long page_size = sysconf( _SC_PAGESIZE );
+    uintptr_t src = (uintptr_t)host, dst = (uintptr_t)placed;
+    off_t offset;
+    void *mapped;
+    int fd, error;
+
+    winehua_shared_map_last_stage = "validate";
+    if (page_size <= 0 || !size || !placed || src % page_size || dst % page_size ||
+        size > SIZE_MAX - (size_t)page_size + 1)
+    { errno = EINVAL; return -1; }
+    size = (size + page_size - 1) / page_size * page_size;
+    if (size > UINTPTR_MAX - src || size > UINTPTR_MAX - dst ||
+        (dst < src + size && src < dst + size))
+    { errno = EINVAL; return -1; }
+    if ((fd = winehua_shared_map_fd( host, size, &offset )) < 0) return -1;
+    mapped = mmap( placed, size, PROT_READ | PROT_WRITE, MAP_SHARED | MAP_FIXED, fd, offset );
+    error = errno;
+    close( fd );
+    if (mapped == placed) winehua_shared_map_last_stage = "shared-alias";
+    errno = error;
+    return mapped == placed ? 0 : -1;
+}
+
+#endif
