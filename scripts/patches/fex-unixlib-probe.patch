diff --git a/Source/Windows/Common/SHMStats.cpp b/Source/Windows/Common/SHMStats.cpp
index 81daa0d72..fae8ce86f 100644
--- a/Source/Windows/Common/SHMStats.cpp
+++ b/Source/Windows/Common/SHMStats.cpp
@@ -12,6 +12,32 @@
 #include <winnt.h>
 #include <wine/debug.h>
 
+#include <cstdio>
+#include <cstdarg>
+
+// [WineHua 实验探针]
+// 不能用 stderr / write(2): Wine 在进程启动时就缓存了 PE 侧 std handle,
+// 而 WineHua 的 NCP 子进程是在其后才把 unix fd 2 重定向到 wine_stderr 日志的,
+// 所以 PE 侧的 fd 2 指向的不是日志 (实测 UnixLib 的 dprintf(2) 可见、PE 侧不可见)。
+// 改为写 Wine 文件系统里的普通文件, hdc 可以直接读。
+#define WINEHUA_FEX_PROBE_FILE "C:\\windows\\temp\\winehua_fex_probe.txt"
+static void WineHuaProbeFmt(const char* Fmt, ...) {
+  char Buffer[256];
+  va_list Args;
+  va_start(Args, Fmt);
+  const int Length = std::vsnprintf(Buffer, sizeof(Buffer), Fmt, Args);
+  va_end(Args);
+  if (Length <= 0) {
+    return;
+  }
+  const size_t ToWrite =
+    static_cast<size_t>(Length) < sizeof(Buffer) ? static_cast<size_t>(Length) : sizeof(Buffer) - 1;
+  if (FILE* File = std::fopen(WINEHUA_FEX_PROBE_FILE, "a")) {
+    std::fwrite(Buffer, 1, ToWrite, File);
+    std::fclose(File);
+  }
+}
+
 namespace FEX::Windows {
