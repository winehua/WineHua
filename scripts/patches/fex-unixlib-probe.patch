   if (CurrentSize == MAX_STATS_SIZE) {
@@ -23,6 +49,8 @@ uint32_t StatAlloc::FrontendAllocateSlots(uint32_t NewSize) {
 
   if (Result.SHMBase) {
     CurrentSize = Result.MappedSize;
+    // [WineHua 实验探针] 扩容路径: 证明 shm 可以按需增长
+    WineHuaProbeFmt("[WINEHUA-FEX-PROBE] shm-grow new_size=%u\n", CurrentSize);
   }
 
   return CurrentSize;
@@ -35,6 +63,13 @@ StatAlloc::StatAlloc(FEXCore::SHMStats::AppType AppType) {
     CurrentSize = Result.MappedSize;
     Base = Result.SHMBase;
     SaveHeader(AppType);
+    // [WineHua 实验探针] 读统计头: 必须在 SaveHeader 之后, 否则读到的是刚 ftruncate 的零页
+    if (Head) {
+      WineHuaProbeFmt("[WINEHUA-FEX-PROBE] shm-header version=%u app_type=%u slot_size=%u capacity=%u size=%u fex_version=%.48s\n",
+                      static_cast<unsigned>(Head->Version), static_cast<unsigned>(Head->app_type),
+                      static_cast<unsigned>(Head->ThreadStatsSize), CurrentSize,
+                      Head->Size.load(std::memory_order_relaxed), Head->fex_version);
+    }
     return;
   }
 }
