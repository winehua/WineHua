+void InvalidationTracker::TraceRWXProbe(uint64_t Address) {
+  // Call the real query, then snapshot membership. The snapshots can race with
+  // a concurrent notification; neither changes intervals or page permissions.
+  const auto Range = QueryExecutableRange(Address);
+  bool X, RWX, Disabled;
+  {
+    std::shared_lock Lock(IntervalsLock);
+    X = XIntervals.Query(Address).Enclosed;
+    RWX = RWXIntervals.Query(Address).Enclosed;
+    Disabled = SMCDetectionDisabled;
+  }
+  MEMORY_BASIC_INFORMATION Info {};
+  const auto Status = NtQueryVirtualMemory(NtCurrentProcess(), reinterpret_cast<void*>(Address),
+                                           MemoryBasicInformation, &Info, sizeof(Info), nullptr);
+  RWXProbeLog("[FEX-RWX-TRACK] pid=%lu tid=%lu addr=0x%llx x=%u rwx=%u smc_disabled=%u query_base=0x%llx query_size=0x%llx query_write=%u vm_status=0x%lx vm_base=%p vm_size=0x%llx vm_prot=0x%lx vm_state=0x%lx\n",
+              GetCurrentProcessId(), GetCurrentThreadId(), Address, X, RWX, Disabled,
+              Range.Base, Range.Size, Range.Writable, Status, Info.BaseAddress,
+              static_cast<uint64_t>(Info.RegionSize), Info.Protect, Info.State);
+}
