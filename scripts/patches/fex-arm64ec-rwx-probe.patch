--- /dev/null
+++ b/Source/Windows/Common/RWXProbe.h
@@ -0,0 +1,23 @@
+// Diagnostic candidate only: bounded, allocation-free output to Wine stderr.
+#pragma once
+#include <atomic>
+#include <cstdarg>
+#include <cstdio>
+#include <windows.h>
+#include <wine/debug.h>
+
+namespace FEX::Windows {
+inline void RWXProbeLog(const char* Format, ...) {
+  const DWORD Error = GetLastError();
+  char Message[1024];
+  va_list Args;
+  va_start(Args, Format);
+  vsnprintf(Message, sizeof(Message), Format, Args);
+  va_end(Args);
+  __wine_dbg_output(Message);
+  SetLastError(Error);
+}
+inline bool RWXProbeBudget(std::atomic<uint32_t>& Count, uint32_t Limit = 256) {
+  return Count.fetch_add(1, std::memory_order_relaxed) < Limit;
+}
+}
