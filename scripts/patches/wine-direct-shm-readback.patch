+static BOOL winehua_readback_pack_invert_supported(void)
+{
+    const struct opengl_context *context = NtCurrentTeb()->glContext;
+
+    /* Use Wine's per-context capability table: GL_EXTENSIONS is not a valid
+     * glGetString query in core contexts, and scanning it per frame is costly. */
+    return context && context->client_context &&
+        opengl_client_context_from_client(context->client_context)->extensions[GL_MESA_pack_invert];
+}
