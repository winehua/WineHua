+/* OPEN is a separate bounded control request; SPAWN retains VPP2 framing. */
+int ohos_broker_open( const char *target )
+{
+    char request[4096];
+    int32_t response[2];
+    vp_received_fds rights = {0};
+    int64_t deadline = vp_now_ms() + 3000;
+    int fd, len, result;
+    if (!target || !*target || strchr(target, '\n') || strchr(target, '\r')) return -1;
+    len = snprintf(request, sizeof(request), "OPEN\n%s\n", target);
+    if (len <= 0 || (size_t)len >= sizeof(request)) return -1;
+    fd = vp_connect_path(broker_socket_path(), deadline);
+    if (fd < 0) return -1;
+    result = vp_send_bytes(fd, request, len, NULL, 0, deadline);
+    if (!result) result = vp_recv_bytes(fd, response, sizeof(response), &rights, deadline);
+    if (rights.count) result = -1;
+    vp_close_fds(&rights);
+    close(fd);
+    return !result && !response[0] && !response[1] ? 0 : -1;
+}
+
 /* Every sender uses the same v2 framing and bounded I/O as the app. */
 static int broker_spawn_spec(const vp_spawn_spec *spec, const int *fds, int *child_pid)
 {
