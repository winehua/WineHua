+namespace {
+struct SteamBoundaryRecord {
+  std::atomic<uint32_t> ready {};
+  uint32_t sequence {};
+  uint32_t pid {};
+  uint32_t tid {};
+  uintptr_t rip {};
+  uintptr_t object {};
+  uintptr_t lock {};
+  uintptr_t rax {};
+  uintptr_t rcx {};
+  uintptr_t rdx {};
+  uintptr_t r14 {};
+  uintptr_t rsp {};
+};
+
+std::array<SteamBoundaryRecord, 1024> SteamBoundaryRecords;
+std::atomic<uint32_t> SteamBoundaryWrite {};
+std::atomic_flag SteamBoundaryFlushing = ATOMIC_FLAG_INIT;
+uint32_t SteamBoundaryRead {};
+std::atomic<uint32_t> SteamTraceThread {};
+std::atomic<uint64_t> SteamTraceLowRsp {};
+std::atomic<uint32_t> SteamTraceReturns {};
+std::atomic<uint32_t> SteamTraceEdges {512};
