+void FlushSteamBoundaries() {
+  if (!WineHuaSteamWebhelperBase || SteamBoundaryFlushing.test_and_set(std::memory_order_acquire)) return;
+  const DWORD error = GetLastError();
+  while (SteamBoundaryRead < SteamBoundaryRecords.size() &&
+         SteamBoundaryRecords[SteamBoundaryRead].ready.load(std::memory_order_acquire)) {
+    const auto& record = SteamBoundaryRecords[SteamBoundaryRead++];
+    char message[320];
+    snprintf(message, sizeof(message),
+             "[steam-boundary] seq=%u pid=%u tid=%u rva=0x%lx object=0x%llx lock=0x%llx rax=0x%llx rcx=0x%llx rdx=0x%llx r14=0x%llx rsp=0x%llx\n",
+             record.sequence, record.pid, record.tid,
+             static_cast<unsigned long>(record.rip - WineHuaSteamWebhelperBase),
+             static_cast<unsigned long long>(record.object), static_cast<unsigned long long>(record.lock),
+             static_cast<unsigned long long>(record.rax), static_cast<unsigned long long>(record.rcx),
+             static_cast<unsigned long long>(record.rdx), static_cast<unsigned long long>(record.r14),
+             static_cast<unsigned long long>(record.rsp));
+    __wine_dbg_output(message);
+  }
+  SetLastError(error);
+  SteamBoundaryFlushing.clear(std::memory_order_release);
+}
+} // namespace
+
+extern "C" void WineHuaGuestBoundary(uintptr_t rip, FEXCore::Core::CpuStateFrame* frame) {
+  if (rip == WineHuaSteamWebhelperBase + 0x131950) {
+    SteamTraceLowRsp.store(frame->State.gregs[FEXCore::X86State::REG_RSP], std::memory_order_relaxed);
+    SteamTraceThread.store(GetCurrentThreadId(), std::memory_order_release);
+  }
+  if (rip == WineHuaSteamWebhelperBase + 0x131d11) SteamTraceEdges.store(0, std::memory_order_relaxed);
+  const uint32_t index = SteamBoundaryWrite.fetch_add(1, std::memory_order_relaxed);
+  if (index >= SteamBoundaryRecords.size()) return;
+  auto& record = SteamBoundaryRecords[index];
+  record.sequence = index;
+  record.pid = GetCurrentProcessId();
+  record.tid = GetCurrentThreadId();
+  record.rip = rip;
+  record.object = frame->State.gregs[(rip == WineHuaSteamWebhelperBase + 0x131950 ||
+                                     rip == WineHuaSteamWebhelperBase + 0x1493f0) ?
+                                    FEXCore::X86State::REG_RCX : FEXCore::X86State::REG_RDI];
+  record.lock = rip == WineHuaSteamWebhelperBase + 0x1493f0 ? 0 : record.object + 0x446;
+  record.rax = frame->State.gregs[FEXCore::X86State::REG_RAX];
+  record.rcx = frame->State.gregs[FEXCore::X86State::REG_RCX];
+  record.rdx = frame->State.gregs[FEXCore::X86State::REG_RDX];
+  record.r14 = frame->State.gregs[FEXCore::X86State::REG_R14];
+  record.rsp = frame->State.gregs[FEXCore::X86State::REG_RSP];
+  record.ready.store(1, std::memory_order_release);
+}
+
+extern "C" void WineHuaGuestCall(uintptr_t target, FEXCore::Core::CpuStateFrame* frame, uint32_t isReturn) {
+  if (GetCurrentThreadId() != SteamTraceThread.load(std::memory_order_acquire)) return;
+  const uint64_t rsp = frame->State.gregs[FEXCore::X86State::REG_RSP];
+  const uint64_t low = SteamTraceLowRsp.load(std::memory_order_relaxed);
+  if (!low) return;
+  const uint32_t edge = SteamTraceEdges.load(std::memory_order_relaxed);
+  const bool early = edge < 512;
+  if (early) SteamTraceEdges.store(edge + 1, std::memory_order_relaxed);
+  if (isReturn) {
+    if (rsp < low || rsp - low > 0x80 ||
+        SteamTraceReturns.fetch_add(1, std::memory_order_relaxed) >= 1) {
+      if (!early) return;
+    }
+  } else {
+    if (rsp < low && low - rsp >= 0x1000) {
+      SteamTraceLowRsp.store(rsp, std::memory_order_relaxed);
+      SteamTraceReturns.store(0, std::memory_order_relaxed);
+    } else if (!early) return;
+  }
+  uint64_t returnAddress = 0;
+  if (!isReturn) memcpy(&returnAddress, reinterpret_cast<const void*>(rsp), sizeof(returnAddress));
+  const DWORD error = GetLastError();
+  char message[210];
+  snprintf(message, sizeof(message), "[steam-call] pid=%lu tid=%lu edge=%u kind=%s target=0x%llx rsp=0x%llx return=0x%llx\n",
+           static_cast<unsigned long>(GetCurrentProcessId()), static_cast<unsigned long>(GetCurrentThreadId()),
+           early ? edge : 512, isReturn ? "ret" : "call", static_cast<unsigned long long>(target),
+           static_cast<unsigned long long>(rsp), static_cast<unsigned long long>(returnAddress));
+  __wine_dbg_output(message);
+  SetLastError(error);
+}
